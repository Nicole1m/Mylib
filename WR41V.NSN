0001/** New Subprogram WR41V.
0002/**
0003/** :author msh
0004/* TODO Enter your code here
0005DEFINE DATA PARAMETER
00061 #PERSONNEL-ID (A8)
00071 #NAME (A20)
0008LOCAL
0009
00101 VEHICLES VIEW OF VEHICLES
0011  2 REG-NUM (A15)
0012  2 CHASSIS-NUM (B4)
0013  2 PERSONNEL-ID (A8) 
0014  2 MAKE (A20)
0015  2 MODEL (A20)
0016  2 COLOUR (A10)
0017  2 YEAR (N4.0)
0018  2 DATE-ACQ (N8.0)
0019
0020
0021
00221 #PERSON-ID (A8) 
00231 #SURNAME (A20)
00241 #REG-NUM (A15)
00251 #MAKE (A20)
00261 #MODEL (A20)
00271 #COLOUR (A10)
00281 #YEAR (N4.0)
0029
00301 #CHASSIS-NUM (B4)
0031
00321 #DATE-ACQ (N8.0)
00331 REDEFINE #DATE-ACQ
0034  2 #DATE-A (N4)
0035
00361 #COUNT (N5)
0037
00381 #DATE-Y (A8)
00391 REDEFINE #DATE-Y 
0040  2 #D-YEAR(A4)
0041
00421 #CV-REG-NUM (C)
00431 #CV-MAKE (C)
00441 #CV-MODEL (C)
00451 #CV-COLOUR (C)
00461 #CV-CHASSIS-NUM (C)
00471 #CV-DATE-ACQ (C)
00481 #CV-YEAR (C)
0049
0050END-DEFINE
0051
0052SET KEY 
0053  PF4 NAMED 'UPDATE'
0054
0055MOVE *DATN TO #DATE-Y
0056
0057
0058MOVE (AD=P) TO
0059
0060  #CV-REG-NUM
0061  #CV-MAKE
0062  #CV-MODEL
0063  #CV-COLOUR
0064  #CV-CHASSIS-NUM
0065  #CV-DATE-ACQ
0066  #CV-YEAR
0067
0068
0069F1. FIND VEHICLES WITH PERSONNEL-ID EQ #PERSONNEL-ID
0070
0071  ADD 1 TO #COUNT
0072
0073  #PERSON-ID := PERSONNEL-ID
0074  #SURNAME := #NAME
0075  #REG-NUM := REG-NUM
0076  #MAKE := MAKE
0077  #MODEL := MODEL
0078  #COLOUR := COLOUR
0079  #YEAR := YEAR
0080  #CHASSIS-NUM := CHASSIS-NUM
0081  #DATE-ACQ := DATE-ACQ
0082
0083  INPUT USING MAP "WR41VEH"
0084
0085  IF *PF-KEY = 'PF4'
0086    MOVE (AD=I) TO
0087      #CV-REG-NUM
0088      #CV-MAKE
0089      #CV-MODEL
0090      #CV-COLOUR
0091      #CV-CHASSIS-NUM
0092      #CV-DATE-ACQ
0093      #CV-YEAR
0094    INPUT USING MAP "WR41VEH"
0095
0096
0097    IF #NAME = ' '
0098      REINPUT 'NAME IS REQUIRED'
0099        MARK *#NAME
0100    END-IF
0101
0102    IF #REG-NUM = ' '
0103      REINPUT 'REG-NUM IS REQUIRED'
0104        MARK *#REG-NUM
0105    END-IF
0106
0107    IF #MAKE = ' '
0108      REINPUT 'MAKE IS REQUIRED'
0109        MARK *#MAKE
0110    END-IF
0111
0112    IF #MODEL = ' '
0113      REINPUT 'MODEL IS REQUIRED'
0114        MARK *#MODEL
0115    END-IF
0116
0117    IF #COLOUR = ' '
0118      REINPUT 'COLOUR IS REQUIRED'
0119        MARK *#COLOUR
0120    END-IF
0121
0122    IF #CHASSIS-NUM = ' '
0123      REINPUT 'CHASSIS-NUM IS REQUIRED'
0124        MARK *#CHASSIS-NUM
0125    END-IF
0126
0127
0128    IF NOT (#DATE-ACQ = MASK(YYYYMMDD) )
0129      REINPUT 'INVALID DATE / DATE CANNOT BE BLANK'
0130        MARK *#DATE-ACQ
0131    END-IF
0132
0133    IF #YEAR < 1800  OR #YEAR > VAL(#D-YEAR)
0134      REINPUT 'INVALID YEAR / YEAR EXCEEDS CURRENT YEAR'
0135        MARK *#YEAR
0136    END-IF
0137
0138    IF #DATE-A LT #YEAR
0139      REINPUT 'DATE ACQ CANNOT BE BEFORE YEAR'
0140        MARK *#DATE-ACQ
0141    END-IF
0142
0143    UPDATE
0144
0145    MOVE (AD=P) TO
0146      #CV-REG-NUM
0147      #CV-MAKE
0148      #CV-MODEL
0149      #CV-COLOUR
0150      #CV-CHASSIS-NUM
0151      #CV-DATE-ACQ
0152      #CV-YEAR
0153
0154    PERSONNEL-ID := #PERSON-ID
0155    #NAME := #SURNAME
0156    REG-NUM := #REG-NUM
0157    MAKE := #MAKE
0158    MODEL := #MODEL
0159    COLOUR := #COLOUR
0160    YEAR := #YEAR
0161    CHASSIS-NUM := #CHASSIS-NUM
0162    DATE-ACQ := #DATE-ACQ
0163
0164
0165    INPUT WITH TEXT 'RECORD HAS BEEN UPDATED'
0166
0167      USING MAP "WR41VEH"
0168
0169  END-IF
0170END-FIND
0171
0172IF #COUNT = 0
0173  WRITE 'Pers-id:' #PERSONNEL-ID /
0174    'Name:' #NAME /
0175    'DOES NOT HAVE A VEHICLE'
0176END-IF
0177
0178END
