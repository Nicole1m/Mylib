0037  EMPLOYEES.GENDER
0038  '</GENDER>' INTO #XML_SERIALZE_OUTPUT LEAVING NO
0039  
0040  COMPRESS #XML_SERIALZE_OUTPUT
0041  '<MAR-STAT>' INTO #XML_SERIALZE_OUTPUT LEAVING NO
