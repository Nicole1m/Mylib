0043  EMPLOYEES.MAR-STAT
0044  '</MAR-STAT>' INTO #XML_SERIALZE_OUTPUT LEAVING NO
0045  
0046  COMPRESS #XML_SERIALZE_OUTPUT
0047  '<CITY>' INTO #XML_SERIALZE_OUTPUT LEAVING NO
