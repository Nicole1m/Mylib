0005DEFINE DATA PARAMETER
00061 #XML_SERIALZE_OUTPUT (A) DYNAMIC
0007PARAMETER USING EMPLXML
0008LOCAL
0009
0010END-DEFINE
0011
0012
0013IF #XML_SERIALZE_OUTPUT = SCAN 'xml version='
0014  IGNORE
0015ELSE
0016  COMPRESS        '<?xml version="1.0" encoding="' *CODEPAGE '"?>'
0017    INTO #XML_SERIALZE_OUTPUT LEAVING NO
0018  COMPRESS #XML_SERIALZE_OUTPUT
0019    '<EMP>' INTO #XML_SERIALZE_OUTPUT LEAVING NO
0020END-IF
0021*
0022COMPRESS #XML_SERIALZE_OUTPUT
0023  '<PERSONNEL-ID>' INTO #XML_SERIALZE_OUTPUT LEAVING NO
