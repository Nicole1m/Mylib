0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
0006
00071 EMPLOYEES VIEW OF EMPLOYEES
0008  2 PERSONNEL-ID (A8) 
0009  2 LANG (A3/1:5)
0010  2 C*LANG (N3)
00111 #LANG-ARRAY (A3/1:40)
00121 #INDEX1 (N5)
00131 #INDEX2(N5)
00141 #COUNT (N5)
00151 #TOTAL (N5)
00161 LANG-COUNT(N5/1:40)
0017END-DEFINE
0018
0019DEFINE WORK FILE 1 'C:\Training\Lang-array.txt'
0020
0021READ EMPLOYEES BY PERSONNEL-ID
0022
0023  FOR #INDEX1 = 1 TO C*LANG
0024    ADD 1 TO #TOTAL
0025    FOR #INDEX2 = 1 TO 40
0026      IF #LANG-ARRAY(#INDEX2) = ' '
0027        MOVE LANG(#INDEX1) TO #LANG-ARRAY(#INDEX2)
0028        ADD 1 TO LANG-COUNT(#INDEX2)
0029        ESCAPE BOTTOM
0030      ELSE
0031        IF #LANG-ARRAY(#INDEX2) = LANG(#INDEX1)
0032          ADD 1 TO LANG-COUNT(#INDEX2)
0033          ESCAPE BOTTOM 
0034        END-IF
0035      END-IF
0036    END-FOR
0037  END-FOR
0038END-READ
0039
0040FOR #INDEX2 = 1 TO 40
0041  IF #LANG-ARRAY(#INDEX2) = ' '
0042    ESCAPE BOTTOM
0043    END-IF
0044    
0045    WRITE WORK FILE 1 #LANG-ARRAY(#INDEX2)   '='   LANG-COUNT(#INDEX2)
0046END-FOR
0047
0048WRITE #TOTAL
0049END
