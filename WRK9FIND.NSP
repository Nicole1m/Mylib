0005DEFINE DATA LOCAL
0006
00071 EMPLOYEES VIEW OF EMPLOYEES
0008  2 PERSONNEL-ID (A8) 
0009  2 NAME (A20)
0010  2 CITY (A20)
0011  2 COUNTRY (A3)
0012  2 LANG (A3/1:5)
0013  2 C*LANG (N3)
0014
0015END-DEFINE
0016
0017FORMAT LS= 120
0018FORMAT PS= 22
0019
0020F1. FIND EMPLOYEES WITH 
0021    EMPLOYEES.CITY EQ 'DARMSTADT'
0022
0023  IF NO RECORD FOUND
0024    WRITE 'NO RECORDS FOUND'
0025    ESCAPE BOTTOM (F1.)
0026  END-NOREC
0027
0028
0029  DISPLAY *ISN
0030    PERSONNEL-ID
0031    NAME (AL=10)
0032   'CNT' COUNTRY (AL=3)
0033*     CITY (AL=10)
0034    LANG (1)
0035    LANG (2)
0036    LANG (3)
0037    LANG (4)
0038    LANG (5)
0039  'COUNT:' C*LANG 
0040
0041END-FIND
0042
0043END
