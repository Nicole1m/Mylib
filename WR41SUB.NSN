0005DEFINE DATA PARAMETER 
00061 #PERSONNEL-ID (A8)  
0007
0008LOCAL
00091 EMPLOYEES VIEW OF EMPLOYEES
0010  2 PERSONNEL-ID (A8)
0011  2 NAME (A20)
0012  2 ADDRESS-LINE (A20/1:2)
0013  2 CITY (A20)
0014  2 POST-CODE (A10)
0015  2 COUNTRY (A3)
0016  2 AREA-CODE (A6)
0017  2 PHONE (A15)
0018
00191 #INDEX (N4) 
0020
0021
00221 #ADDRESS (A20/1:2)
00231 #AREA-CODE (A6)
00241 #CITY (A20)
00251 #COUNTRY (A3)
00261 #NAME (A20)
00271 #PERS-ID (A8)
00281 #POST-CODE (A10)
00291 #TELEPHONE (A15)
0030
00311 #CV-ADDRESS (C/1:2)
00321 #CV-CITY (C)
00331 #CV-POST-CODE (C)
0034
0035END-DEFINE
0036
0037SET KEY 
0038  PF4 NAMED 'UPDATE'
0039
0040MOVE (AD=P) TO
0041  #CV-ADDRESS(1:2)
0042  #CV-POST-CODE
0043  #CV-CITY
0044
0045FIND EMPLOYEES WITH PERSONNEL-ID EQ #PERSONNEL-ID
0046
0047
0048  #PERS-ID := PERSONNEL-ID 
0049  #NAME := NAME
0050  #ADDRESS(*) := ADDRESS-LINE (*)
0051  #POST-CODE := POST-CODE
0052  #CITY := CITY
0053  #COUNTRY := COUNTRY
0054  #AREA-CODE := AREA-CODE
0055  #TELEPHONE := PHONE
0056  
0057   INPUT USING MAP "WR41MAP"
0058
0059  IF *PF-KEY = 'PF4'
0060    MOVE (AD=I) TO
0061      #CV-ADDRESS(1:2)
0062      #CV-CITY
0063      #CV-POST-CODE
0064    INPUT USING MAP "WR41MAP"
0065  
0066
0067  IF #ADDRESS(1) = ' '
0068    REINPUT 'ADDRESS IS REQUIRED'
0069      MARK *#ADDRESS(1)
0070  END-IF 
0071
0072  IF #CITY = ' '
0073    REINPUT 'CITY IS REQUIRED'
0074      MARK *#CITY
0075  END-IF 
0076
0077  IF  #POST-CODE = ' '
0078    REINPUT 'POST-CODE IS REQUIRED'
0079      MARK *#POST-CODE
0080  END-IF 
0081
0082  UPDATE
0083
0084  MOVE (AD=P) TO
0085    #CV-ADDRESS(1:2)
0086    #CV-POST-CODE
0087    #CV-CITY
0088    
0089   MOVE #ADDRESS(1:2) TO ADDRESS-LINE(1:2)
0090  MOVE #CITY         TO CITY
0091  MOVE #POST-CODE     TO POST-CODE
0092
0093  INPUT WITH TEXT 'RECORD HAS BEEN UPDATED'
0094    USING MAP "WR41MAP"
0095
0096END-IF
0097END-FIND 
0098
0099 /* PUT THE MAP AFTER FIND STATEMENT BECAUSE
0100/* WE ARE DISPLAYING ONE RECORD AT A TIME SINCE PERS ID IS UNIQUE PER EMPLOYEE
0101
0102
0103END
