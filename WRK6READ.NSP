0006DEFINE DATA LOCAL 
0007
00081 EMPLOYEES VIEW OF EMPLOYEES
0009  2 PERSONNEL-ID (A8) 
0010  2 FIRST-NAME (A20)
0011  2 NAME (A20)
0012  2 CITY (A20)
0013 2 LANG (1:4)
0014  
0015END-DEFINE
0016*
0017FORMAT LS=150
0018FORMAT PS=40
0019*
0020
0021READ EMPLOYEES BY CITY
0022    FROM 'MADRID' TO 'MADRID'
0023  DISPLAY  *ISN 'Employees'
0024 EMPLOYEES.PERSONNEL-ID
0025 EMPLOYEES.FIRST-NAME  (AL=10)
0026 EMPLOYEES.NAME (AL=10)
0027 EMPLOYEES.CITY (AL=10)
0028 EMPLOYEES.LANG (1)
0029 EMPLOYEES.LANG (2)
0030 EMPLOYEES.LANG (3)
0031 EMPLOYEES.LANG (4)
0032END-READ
0033END
