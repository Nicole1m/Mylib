0004/* TODO Enter your code here
0005DEFINE DATA LOCAL 
00061 #NO-DUPS (A40)
00071 REDEFINE #NO-DUPS
0008  2 #IN-ARRAY(A1/1:40)
0009
00101 #INDEX1 (N5)
00111 #LEN (N5)
0012END-DEFINE
0013
0014DEFINE WORK FILE 1 'C:\Training\english words no dups.txt'
0015DEFINE WORK FILE 2 'C:\Training\ 3 letter words.txt'
0016DEFINE WORK FILE 3 'C:\Training\4 letter words.txt'
0017DEFINE WORK FILE 4 'C:\Training\5 letter words.txt'
0018DEFINE WORK FILE 5 'C:\Training\6 letter words.txt'
0019DEFINE WORK FILE 6 'C:\Training\7 letter words.txt'
0020DEFINE WORK FILE 7 'C:\Training\8 letter words.txt'
0021DEFINE WORK FILE 8 'C:\Training\9 letter words.txt'  
0022DEFINE WORK FILE 9 'C:\Training\10 letter words.txt'  
0023DEFINE WORK FILE 10 'C:\Training\11 letter words.txt'  
0024DEFINE WORK FILE 11 'C:\Training\12 letter words.txt'  
0025
0026READ WORK  1 #NO-DUPS
0027  FOR #INDEX1 = 1 TO 40 
0028    IF #IN-ARRAY(#INDEX1) EQ ' '
0029      #LEN := #INDEX1 - 1
0030      ESCAPE BOTTOM
0031    END-IF
0032  END-FOR
0033*
0034  IF #LEN = 1 OR =2 
0035      OR #LEN GT 12
0036    ESCAPE TOP
0037  END-IF
0038
0039  DECIDE ON FIRST VALUE OF #LEN
0040    VALUE 3  WRITE WORK FILE 2 #NO-DUPS
0041    VALUE 4  WRITE WORK FILE 3 #NO-DUPS
0042    VALUE 5  WRITE WORK FILE 4 #NO-DUPS
0043    VALUE 6  WRITE WORK FILE 5 #NO-DUPS
0044    VALUE 7  WRITE WORK FILE 6 #NO-DUPS
0045    VALUE 8  WRITE WORK FILE 7 #NO-DUPS
0046    VALUE 9  WRITE WORK FILE 8 #NO-DUPS
0047    VALUE 10 WRITE WORK FILE 9 #NO-DUPS
0048    VALUE 11 WRITE WORK FILE 10 #NO-DUPS
0049    VALUE 12 WRITE WORK FILE 11 #NO-DUPS
0050    NONE VALUE
0051      IGNORE
0052  END-DECIDE
0053END-WORK
0054END
