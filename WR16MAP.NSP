0005
0006DEFINE DATA LOCAL
00071 EMPLOYEES VIEW OF EMPLOYEES
0008  2 PERSONNEL-ID (A8)
0009  2 NAME (A20)
0010  2 GENDER (A1)
0011  2 CITY (A20)
0012
00131 #PERSONNEL-ID (A8/1:16)
00141 #NAME          (A20/1:16)
00151 #GENDER        (A1/1:16)
00161 #CITY          (A20/1:16)
00171 #I             (N2)
0018END-DEFINE
0019
0020SET KEY PF3 NAMED 'EXIT'
0021
0022READ EMPLOYEES BY PERSONNEL-ID
0023
0024  ADD 1 TO #I
0025
0026
0027  #PERSONNEL-ID(#I) := PERSONNEL-ID
0028  #NAME(#I)          := NAME
0029  #GENDER(#I)        := GENDER
0030  #CITY(#I)          := CITY
0031
0032  IF #I = 16
0033
0034    INPUT USING MAP "WS16-2M"
0035
0036    IF *PF-KEY= 'PF3'
0037      ESCAPE BOTTOM
0038    END-IF
0039
0040    RESET #I
0041  END-IF
0042
0043END-READ
0044
0045
0046 IF #I < 16
0047 
0048   RESET
0049   #PERSONNEL-ID(#I) 
0050   #NAME(#I)          
0051   #GENDER(#I)        
0052   #CITY(#I)          
0053 
0054 INPUT USING MAP "WS16-2M"
0055 
0056 END-IF
0057END
