0005DEFINE DATA LOCAL 
00061 NUMVALUE (N20) INIT <10>
00071 MESSAGE ( A50) 
0008END-DEFINE
0009
0010*
0011REPEAT
0012UNTIL NUMVALUE = 20
0013ADD 1 TO NUMVALUE
0014  DECIDE FOR EVERY CONDITION
0015    WHEN NUMVALUE = 1 THRU 3
0016      MESSAGE := ' value is 1,2,3'
0017
0018    WHEN NUMVALUE = 5
0019      MESSAGE := ' value is 5'
0020
0021    WHEN NUMVALUE = 7 OR =8 OR =10
0022      MESSAGE := 'value is 7,8,10'
0023
0024    WHEN NUMVALUE = 13 OR =15 THRU 18
0025      MESSAGE := ' value is 13 , or is in the range of 15 to 18'
0026
0027    WHEN NONE
0028      MESSAGE := ' invalid value'
0029
0030  END-DECIDE
0031  WRITE 'The value is =' NUMVALUE
0032  WRITE MESSAGE
0033  
0034END-REPEAT
0035END
