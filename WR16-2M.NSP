0007DEFINE DATA LOCAL
00081 EMPLOYEES VIEW OF EMPLOYEES
0009  2 PERSONNEL-ID (A8)
0010  2 NAME (A20)
0011  2 GENDER (A1)
0012  2 CITY (A20)
0013
00141 #PERSONNEL-ID (A8/1:16)
00151 #NAME          (A20/1:16)
00161 #GENDER        (A1/1:16)
00171 #CITY          (A20/1:16)
00181 #I             (N2)
0019END-DEFINE
0020
0021SET KEY PF3 NAMED 'EXIT'
0022
0023READ EMPLOYEES BY PERSONNEL-ID
0024
0025  ADD 1 TO #I
0026
0027
0028  #PERSONNEL-ID(#I) := PERSONNEL-ID
0029  #NAME(#I)          := NAME
0030  #GENDER(#I)        := GENDER
0031  #CITY(#I)          := CITY
0032
0033  IF #I = 16
0034
0035    INPUT USING MAP "WS16-2M"
0036
0037    IF *PF-KEY= 'PF3'
0038      ESCAPE BOTTOM
0039    END-IF
0040
0041    RESET #I
0042  END-IF
0043
0044END-READ
0045
0046* IF #I < 16
0047*   RESET
0048* MOVE PERSONNEL-ID TO #PERSONNEL-ID(#I)
0049*   #NAME(#I)          := NAME
0050*   #GENDER(#I)        := GENDER
0051*   #CITY(#I)          := CITY
0052* 
0053* INPUT USING MAP "WS16-2M"
0054* 
0055* END-IF
0056END
