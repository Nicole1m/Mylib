0001/** New Program WR16MAP.
0002/**
0003/** :author msh
0004/* TODO Enter your code here
0005
0006DEFINE DATA LOCAL
00071 EMPLOYEES VIEW OF EMPLOYEES
0008  2 PERSONNEL-ID (A8)
0009  2 NAME (A20)
0010  2 GENDER (A1)
0011  2 CITY (A20)
0012
00131 #PERSONNEL-ID (A8/1:16)
00141 #NAME          (A20/1:16)
00151 #GENDER        (A1/1:16)
00161 #CITY          (A20/1:16)
00171 #I             (N2)
0018
00191 #MAKE (A20/ 1:5)
00201 #MODEL (A20/1:5)
00211 #COLOUR (A10/1:5)
00221 #YEAR (N4.0/ 1:5)
0023
00241 #SELECT (A1/1:16)
00251 #SEL-INDEX (N3)
0026
0027END-DEFINE
0028
0029SET KEY PF3 NAMED 'EXIT'
0030
0031READ EMPLOYEES BY PERSONNEL-ID
0032
0033  ADD 1 TO #I
0034
0035  #PERSONNEL-ID(#I) := PERSONNEL-ID
0036  #NAME(#I)          := NAME
0037  #GENDER(#I)        := GENDER
0038  #CITY(#I)          := CITY
0039
0040  IF #I = 16 
0041
0042    INPUT USING MAP "WS16-2M2"
0043
0044    IF *PF-KEY= 'PF3'
0045      ESCAPE BOTTOM
0046    END-IF 
0047
0048
0049    RESET #I 
0050
0051    FOR #SEL-INDEX =1 TO 16
0052      IF #SELECT (#SEL-INDEX)  = 'V'
0053
0054        CALLNAT "WR16-3"
0055          #PERSONNEL-ID (#SEL-INDEX)
0056          #NAME (#SEL-INDEX)
0057
0058        RESET #SELECT (#SEL-INDEX)
0059
0060      END-IF
0061    END-FOR
0062  END-IF
0063END-READ
0064
0065IF #I < 16
0066
0067  RESET
0068    #PERSONNEL-ID(#I)
0069    #NAME(#I)
0070    #GENDER(#I)
0071    #CITY(#I)
0072
0073  INPUT USING MAP "WS16-2M"
0074
0075END-IF
0076END
