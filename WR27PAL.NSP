0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 SENTENCE (A100) 
00071 REDEFINE SENTENCE
0008  2 SENTENCE-ARR (A1/1:70)
0009*
00101 PHRASE (A100)
00111 REDEFINE PHRASE
0012  2 PHRASE-ARR (A1/1:70)
0013*
00141 INDEX (N3)
0015*
00161 COUNT (N5) 
00171 #COUNT (N5)
0018END-DEFINE
0019*
0020DEFINE WORK FILE 1
0021  'C:\Training\MIXED WORDS AND SENTENCES.TXT'
0022*
0023DEFINE WORK FILE 2
0024  'C:\Training\MIXED WORDS AND SENTENCES1.TXT'
0025*
0026READ WORK 1 SENTENCE
0027  ADD 1 TO #COUNT
0028*
0029  EXAMINE SENTENCE FOR ',' DELETE
0030  EXAMINE SENTENCE FOR '-' DELETE
0031  EXAMINE SENTENCE FOR ' ' DELETE
0032  EXAMINE SENTENCE FOR ':' DELETE
0033  EXAMINE SENTENCE FOR '.' DELETE 
0034  EXAMINE SENTENCE FOR '!' DELETE
0035  EXAMINE SENTENCE FOR '’' DELETE
0036  EXAMINE SENTENCE FOR ';' DELETE
0037  EXAMINE SENTENCE FOR '?' DELETE
0038  EXAMINE SENTENCE FOR '""' DELETE
0039  EXAMINE SENTENCE FOR '''' DELETE
0040  EXAMINE SENTENCE FOR '““' DELETE
0041  EXAMINE SENTENCE FOR '””' DELETE
0042  EXAMINE SENTENCE FOR '—' DELETE
0043
0044  EXAMINE SENTENCE TRANSLATE INTO UPPER CASE
0045*
0046  FOR INDEX 1 TO 70
0047    MOVE SENTENCE-ARR(INDEX) TO PHRASE-ARR(71-INDEX)
0048  END-FOR
0049*
0050  MOVE LEFT PHRASE TO PHRASE
0051*
0052  IF SENTENCE EQ PHRASE
0053    ADD 1 TO COUNT
0054    WRITE WORK FILE 2
0055      COUNT' '
0056      SENTENCE
0057      PHRASE
0058  END-IF
0059* 
0060
0061  AT END OF DATA
0062    WRITE 'ORIGINAL WORKFILE:' 
0063       COUNT(SENTENCE) (AD=I)
0064    WRITE 'PALINDROMES:'
0065      COUNT (AD=I)
0066*       COUNT (PHRASE) (AD=I)
0067  END-ENDDATA
0068*
0069END-WORK
0070*
0071CLOSE WORK FILE 1
0072CLOSE WORK FILE 2
0073*
0074END
