0005DEFINE DATA LOCAL 
00061 START-HARBOR  (A32) INIT<'Palma'>
00071 DEST-HARBOR   (A32) INIT<'Valencia'>
0008END-DEFINE
0009DECIDE FOR EVERY CONDITION
0010  WHEN START-HARBOR = 'PTA' OR DEST-HARBOR = 'Rome'
0011    DEST-HARBOR :=  'Athens'
0012  WHEN START-HARBOR = 'PTA'
0013    START-HARBOR := 'Barcelona'
0014  WHEN DEST-HARBOR = 'JHB'
