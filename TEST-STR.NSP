0004/* TODO Enter your code here
0005DEFINE DATA LOCAL 
00061 CRUISE-ID (A5)
00071 CRUISE-STATUS (A5)
00081 CRUISE-START (A20)
0009****************** START TIME 
00101 REDEFINE CRUISE-START
0011  2 START-YEAR (N4)
0012  2 START-MONTHS (N2)
0013  2 START-DAYS (N2)
00141 #NUM-START (N2)
00151 START-TIME (A4)
0016
0017***************END TIME
00181 CRUISE-END (A20)
00191 REDEFINE CRUISE-END
0020  2 END-YEAR (N4)
0021  2 END-MONTHS (N2)
0022  2 END-DAYS (N2)
00231 #NUM-END (N2)
00241 END-TIME (A4)
0025
00261 START-HARBOUR (A50)
00271 DESTINATION-HARBOUR (A20)
00281 YACHT-ID (A4)
0029
00301 #IN-REC (A100)
0031
0032
0033
0034END-DEFINE
0035
0036DEFINE WORK FILE 1 'C:\Training\new-cruises.txt'
0037DEFINE WORK FILE 2 'C:\Training\new cruises 2.txt'
0038
0039READ WORK 1 #IN-REC 
0040
0041  EXAMINE #IN-REC FOR FULL VALUE OF PATTERN '(*)' DELETE
0042  
0043  SEPARATE #IN-REC INTO
0044    CRUISE-ID
0045    CRUISE-STATUS
0046    CRUISE-START
0047    CRUISE-END
0048    START-HARBOUR
0049    DESTINATION-HARBOUR
0050    YACHT-ID
0051   IGNORE WITH DELIMITER '#'
0052
0053  SEPARATE CRUISE-START INTO CRUISE-START START-TIME
0054  IGNORE WITH DELIMITER '-' 
0055
0056  SEPARATE CRUISE-END INTO CRUISE-END END-TIME
0057  IGNORE WITH DELIMITER '-'
0058  
0059  
0060  ADD 3 TO START-YEAR 
0061  ADD 6 TO START-MONTHS
0062
0063  ADD 3 TO END-YEAR
0064  ADD 6 TO END-MONTHS  
0065
0066  IF START-MONTHS >  12
0067    ADD 1 TO START-YEAR
0068    SUBTRACT 12 FROM START-MONTHS
0069      GIVING #NUM-START
0070    MOVE #NUM-START TO START-MONTHS
0071  END-IF
0072
0073  IF END-MONTHS >  12
0074    ADD 1 TO END-YEAR
0075    SUBTRACT 12 FROM END-MONTHS
0076      GIVING #NUM-END
0077    MOVE #NUM-END TO END-MONTHS
0078  END-IF
0079
0080
0081  WRITE WORK 2
0082    CRUISE-ID
0083    CRUISE-STATUS
0084    CRUISE-START
0085    START-TIME
0086    CRUISE-END
0087    END-TIME
0088    START-HARBOUR
0089    DESTINATION-HARBOUR
0090    YACHT-ID
0091
0092
0093  RESET #NUM-START
0094  RESET #NUM-END
0095
0096END-WORK
0097
0098ON ERROR
0099  WRITE CRUISE-ID
0100    CRUISE-STATUS
0101    CRUISE-START
0102    CRUISE-END
0103    START-HARBOUR
0104    DESTINATION-HARBOUR
0105    YACHT-ID
0106END-ERROR
0107END
