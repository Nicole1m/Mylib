0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 #RECORD (A200)
00071 #EMAIL (N5)
00081 #NUMERIC (N5)
00091 #SENTENCE (N5)
00101 #WORD (N5)
00111 #NUM (I4)
00121 #TOTAL (N5)
0013
0014END-DEFINE
0015
0016DEFINE WORK FILE 1 'C:\Training\test-data.txt'
0017DEFINE WORK FILE 2 'C:\Training\email address.txt.'
0018DEFINE WORK FILE 3 'C:\Training\numeric.txt.'
0019DEFINE WORK FILE 4 'C:\Training\sentences.txt.'
0020DEFINE WORK FILE 5 'C:\Training\words.txt.'
0021DEFINE WORK FILE 6 'C:\Training\Totals.txt'
0022*
0023READ WORK 1 #RECORD
0024  ADD 1 TO #TOTAL
0025
0026  EXAMINE #RECORD FOR '@' GIVING POSITION #NUM
0027  IF #NUM GT 0
0028    ADD 1 TO #EMAIL
0029    WRITE WORK 2 #RECORD
0030    ESCAPE TOP
0031  END-IF
0032
0033  IF SUBSTRING(#RECORD,1,1) EQ '0' THRU '9'
0034    ADD 1 TO #NUMERIC
0035    WRITE WORK FILE 3 #RECORD
0036    ESCAPE TOP
0037  END-IF
0038
0039  EXAMINE #RECORD FOR ' ' GIVING POSITION #NUM
0040  IF #NUM>0
0041    ADD 1 TO #SENTENCE
0042    WRITE WORK 4 #RECORD
0043    ESCAPE TOP
0044  END-IF
0045
0046  ADD 1 TO #WORD
0047  WRITE WORK 5 #RECORD
0048END-WORK
0049
0050WRITE WORK FILE 6 'EMAILS:   '   #EMAIL  
0051WRITE WORK FILE 6 'NUMERIC:  '   #NUMERIC
0052WRITE WORK FILE 6 'SENTENCES:'   #SENTENCE
0053WRITE WORK FILE 6 'WORDS:    '   #WORD
0054WRITE WORK FILE 6 'TOTALS:   '   #TOTAL
0055*
0056CLOSE WORK FILE 1
0057CLOSE WORK FILE 2
0058CLOSE WORK FILE 3
0059CLOSE WORK FILE 4
0060CLOSE WORK FILE 5
0061CLOSE WORK FILE 6
0062*
0063END
