0004/* TODO Enter your code here
0005***************************************************
0006***THIS PROGRAM DISPLAYS EMPLOYEES IN SALE20
0007******************************************************
0008DEFINE DATA LOCAL 
00091 EMPLOYEES-VIEW VIEW OF EMPLOYEES
0010  2 PERSONNEL-ID (A8) 
0011  2 NAME (A20)
0012  2 DEPT (A6)
0013  2 CITY (A20)
0014  2 COUNTRY (A3)
0015  2 LANG (A3/1:5)
0016END-DEFINE 
0017
0018FORMAT LS = 80
0019PS = 20
0020
0021WRITE TITLE LEFT JUSTIFIED 
0022'PROGRAM: '*PROGRAM 26T 'SAG INTERNS EMPLOYEE SYSTEM'  62T 'PAGE: '  *PAGE-NUMBER
0023  / 'DATE: '*DAT4D 25T 'LANGUAGES SPOKEN PER EMPLOYEE' 62T 'TIME: '*TIME
0024  / 30T 'DEPARTMENT: SALE20'
0025  / '-' (79)
0026
0027  'PERS ID' 2X 'NAME' 17X 'CITY' 17X 'CNTY' 1X 'LANG'
0028  / '-'(79)
0029
0030WRITE TRAILER
0031
0032  '-' (79)
0033************ BODY ***********************************************
0034F1. FIND EMPLOYEES-VIEW WITH DEPT = 'SALE20' 
0035
0036
0037  WRITE
0038    PERSONNEL-ID 
0039    10T NAME
0040    31T CITY
0041    52T COUNTRY
0042    57T LANG(*)
0043
0044********END******************************************
0045  AT END OF DATA
0046    WRITE  '*' (79)
0047      'EMPLOYEES FOUND' COUNT(F1.)(EMPLOYEES-VIEW.PERSONNEL-ID)
0048      /'END OF REPORT'
0049
0050      '*' (79)
0051  END-ENDDATA
0052END-FIND
0053
0054
0055END
