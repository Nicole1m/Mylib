0001/** New Function WRK61-2.
0002/**
0003/** :author msh
0004DEFINE FUNCTION SALARY-INCREASE
0005  RETURNS NEW-SALARY (N9.2)
0006  DEFINE DATA PARAMETER
0007  1 CURR-SALARY (N9.2)
0008  1 PERCENT (N2.2)
0009  END-DEFINE
0010*
0011  NEW-SALARY := CURR-SALARY * (1 + PERCENT)
0012
0013*
0014END-FUNCTION
0015END
