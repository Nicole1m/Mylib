0001/** New Program WK53SUB.
0002/**
0003/** :author msh
0004/* TODO Enter your code here
0005DEFINE DATA LOCAL 
00061 #NO-DUPS (A40)
00071 #INDEX1 (N5)
00081 #LEN (N5)
0009END-DEFINE
0010
0011DEFINE WORK FILE 1 'C:\Training\english words no dups.txt'
0012DEFINE WORK FILE 2 'C:\Training\ 3 letter words-2.txt'
0013DEFINE WORK FILE 3 'C:\Training\4 letter words-2.txt'
0014DEFINE WORK FILE 4 'C:\Training\5 letter words-2.txt'
0015DEFINE WORK FILE 5 'C:\Training\6 letter words-2.txt'
0016DEFINE WORK FILE 6 'C:\Training\7 letter words-2.txt'
0017DEFINE WORK FILE 7 'C:\Training\8 letter words-2.txt'
0018DEFINE WORK FILE 8 'C:\Training\9 letter words-2.txt'  
0019DEFINE WORK FILE 9 'C:\Training\10 letter words-2.txt'  
0020DEFINE WORK FILE 10 'C:\Training\11 letter words-2.txt'  
0021DEFINE WORK FILE 11 'C:\Training\12 letter words-2.txt'  
0022
0023READ WORK  1 #NO-DUPS
0024  FOR #INDEX1 = 1 TO 40 
0025     IF SUBSTRING(#NO-DUPS,#INDEX1,1) EQ ' '
0026    #LEN := #INDEX1 - 1
0027    ESCAPE BOTTOM
0028
0029END-IF
0030  END-FOR
0031  
0032*
0033  IF #LEN = 1 OR =2 
0034      OR #LEN GT 12
0035    ESCAPE TOP
0036  END-IF
0037
0038  DECIDE ON FIRST VALUE OF #LEN
0039    VALUE 3  WRITE WORK FILE 2 #NO-DUPS
0040    VALUE 4  WRITE WORK FILE 3 #NO-DUPS
0041    VALUE 5  WRITE WORK FILE 4 #NO-DUPS
0042    VALUE 6  WRITE WORK FILE 5 #NO-DUPS
0043    VALUE 7  WRITE WORK FILE 6 #NO-DUPS
0044    VALUE 8  WRITE WORK FILE 7 #NO-DUPS
0045    VALUE 9  WRITE WORK FILE 8 #NO-DUPS
0046    VALUE 10 WRITE WORK FILE 9 #NO-DUPS
0047    VALUE 11 WRITE WORK FILE 10 #NO-DUPS
0048    VALUE 12 WRITE WORK FILE 11 #NO-DUPS
0049    NONE VALUE
0050      IGNORE
0051  END-DECIDE
0052END-WORK
0053END
0054
