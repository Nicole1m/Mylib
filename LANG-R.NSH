0004/* TODO Enter your code here
0005DEFINE DATA 
0006PARAMETER
00071 #LANG-PARM (A4)
0008
0009
0010LOCAL
00111 #SELECT (A1/1:12)
00121 #INDEX (N1)
00131 #LANGUAGE (A4/1:3)
0014END-DEFINE
0015
0016INPUT USING MAP "LANG1"
0017
0018IF *PF-KEY = 'PF3'
0019  ESCAPE MODULE
0020END-IF
0021
0022IF #SELECT(*) = 'X'
0023DECIDE FOR FIRST CONDITION
0024  WHEN #SELECT(1) NE ' '
0025    MOVE 'ENG' TO #LANG-PARM
0026
0027
0028  WHEN #SELECT(2) NE ' '
0029    MOVE 'AFR' TO #LANG-PARM
0030
0031  WHEN #SELECT(3) NE ' '
0032    MOVE 'NBL' TO #LANG-PARM
0033
0034  WHEN #SELECT(4) NE ' '
0035    MOVE 'XHO' TO #LANG-PARM
0036
0037  WHEN #SELECT(5) NE ' '
0038    MOVE 'ZUL' TO #LANG-PARM
0039
0040  WHEN #SELECT(6) NE ' '
0041    MOVE 'NSO' TO #LANG-PARM
0042
0043  WHEN #SELECT(7) NE ' '
0044    MOVE 'SOT' TO #LANG-PARM
0045
0046  WHEN #SELECT(8) NE ' '
0047    MOVE 'TSN' TO #LANG-PARM
0048
0049  WHEN #SELECT(9) NE ' '
0050    MOVE 'SSW' TO #LANG-PARM
0051
0052  WHEN #SELECT(10) NE ' '
0053    MOVE 'VEN' TO #LANG-PARM
0054
0055  WHEN #SELECT(11) NE ' '
0056    MOVE 'TSO' TO #LANG-PARM
0057
0058  WHEN #SELECT(12) NE ' '
0059    MOVE 'SASL' TO #LANG-PARM
0060
0061  WHEN NONE
0062    REINPUT ' Please select one option with "X"'
0063END-DECIDE
0064
0065  ELSE
0066    REINPUT ' Please select one option with "X"'
0067    END-IF
0068END
0069
