0001/** New Subprogram WR41COM.
0002/**
0003/** :author msh
0004/* TODO Enter your code here
0005DEFINE DATA 
0006PARAMETER 
00071 #PERSONNEL-ID (A8)
0008
0009LOCAL
00101 EMPLOYEES VIEW OF EMPLOYEES
0011  2 PERSONNEL-ID (A8) 
0012  2 NAME (A20)
0013  2 DEPT (A6)
0014  2 CURR-CODE (A3/1:3)
0015  2 SALARY (P9.0/1:3)
0016  2 JOB-TITTLE (A25)
0017  2 BONUS (P9.0/1:3,1:3)
0018  2 LEAVE-DUE (N2.0)
0019  2 LEAVE-TAKEN (N2.0)
0020  2 LEAVE-END (N8.0/1:3)
0021  2 LEAVE-START (N8.0/1:3)
0022
00231 #INDEX (I4) 
00241 #CV-DEPT (C)
00251 #CV-JOB-TITLE (C)
0026
0027END-DEFINE
0028
0029SET KEY 
0030  PF4 NAMED 'UPDATE'
0031
0032MOVE (AD=P) TO #CV-DEPT
0033MOVE (AD=P) TO #CV-JOB-TITLE
0034
0035FIND EMPLOYEES WITH PERSONNEL-ID = #PERSONNEL-ID
0036
0037  INPUT USING MAP "WR41COMM"
0038
0039  IF *PF-KEY = 'PF4'
0040    MOVE (AD=I) TO #CV-DEPT
0041    MOVE (AD=I) TO #CV-JOB-TITLE
0042    INPUT USING MAP "WR41COMM"
0043
0044    IF JOB-TITTLE = ' '
0045      REINPUT 'Job title IS REQUIRED'
0046        MARK *JOB-TITTLE
0047    END-IF
0048
0049    IF DEPT = ' '
0050      REINPUT 'Department IS REQUIRED'
0051        MARK *DEPT
0052    END-IF
0053  END-IF
0054
0055
0056  MOVE (AD=P) TO #CV-DEPT
0057  MOVE (AD=P) TO #CV-JOB-TITLE
0058
0059  UPDATE 
0060  
0061  INPUT WITH TEXT 'RECORD HAS BEEN UPDATED'
0062    USING MAP "WR41COMM"
0063END-FIND
0064END
