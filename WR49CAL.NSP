0004/* TODO Enter your code here
0005
0006DEFINE DATA LOCAL
00071 #ALPHA (A1/1:26) 
00081 #POINT (N2/1:26)
00091 #TOTAL (N5)
00101 #INDEX1 (N2)
00111 #INDEX2 (N2)
00121 #LEN (N2)
00131 #IN-WORD (A25)
00141 REDEFINE #IN-WORD
0015  2 #IN-ARRAY (A1/1:25)
0016END-DEFINE
0017
0018/* Initialize alphabet */
0019MOVE 'A' TO #ALPHA (1)
0020MOVE 'B' TO #ALPHA (2)
0021MOVE 'C' TO #ALPHA (3)
0022MOVE 'D' TO #ALPHA (4)
0023MOVE 'E' TO #ALPHA (5)
0024MOVE 'F' TO #ALPHA (6)
0025MOVE 'G' TO #ALPHA (7)
0026MOVE 'H' TO #ALPHA (8)
0027MOVE 'I' TO #ALPHA (9)
0028MOVE 'J' TO #ALPHA (10)
0029MOVE 'K' TO #ALPHA (11)
0030MOVE 'L' TO #ALPHA (12)
0031MOVE 'M' TO #ALPHA (13)
0032MOVE 'N' TO #ALPHA (14)
0033MOVE 'O' TO #ALPHA (15)
0034MOVE 'P' TO #ALPHA (16)
0035MOVE 'Q' TO #ALPHA (17)
0036MOVE 'R' TO #ALPHA (18)
0037MOVE 'S' TO #ALPHA (19)
0038MOVE 'T' TO #ALPHA (20)
0039MOVE 'U' TO #ALPHA (21)
0040MOVE 'V' TO #ALPHA (22)
0041MOVE 'W' TO #ALPHA (23)
0042MOVE 'X' TO #ALPHA (24)
0043MOVE 'Y' TO #ALPHA (25)
0044MOVE 'Z' TO #ALPHA (26)
0045
0046/* Scrabble Points */
0047MOVE 1  TO #POINT (1)   /* A */
0048MOVE 3  TO #POINT (2)   /* B */
0049MOVE 3  TO #POINT (3)   /* C */
0050MOVE 2  TO #POINT (4)   /* D */
0051MOVE 1  TO #POINT (5)   /* E */
0052MOVE 4  TO #POINT (6)   /* F */
0053MOVE 2  TO #POINT (7)   /* G */
0054MOVE 4  TO #POINT (8)   /* H */
0055MOVE 1  TO #POINT (9)   /* I */
0056MOVE 8  TO #POINT (10)  /* J */
0057MOVE 5  TO #POINT (11)  /* K */
0058MOVE 1  TO #POINT (12)  /* L */
0059MOVE 3  TO #POINT (13)  /* M */
0060MOVE 1  TO #POINT (14)  /* N */
0061MOVE 1  TO #POINT (15)  /* O */
0062MOVE 3  TO #POINT (16)  /* P */
0063MOVE 10 TO #POINT (17)  /* Q */
0064MOVE 1  TO #POINT (18)  /* R */
0065MOVE 1  TO #POINT (19)  /* S */
0066MOVE 1  TO #POINT (20)  /* T */
0067MOVE 1  TO #POINT (21)  /* U */
0068MOVE 4  TO #POINT (22)  /* V */
0069MOVE 4  TO #POINT (23)  /* W */
0070MOVE 8  TO #POINT (24)  /* X */
0071MOVE 4  TO #POINT (25)  /* Y */
0072MOVE 10 TO #POINT (26)  /* Z */
0073
0074/* Ask user for input */
0075INPUT 'ENTER WORD: ' #IN-WORD
0076
0077 #IN-WORD := *TRANSLATE (#IN-WORD, UPPER)
0078
0079/* Initialize */
0080MOVE 0 TO #LEN
0081
0082FOR #INDEX1 = 1 TO 25
0083  IF #IN-ARRAY(#INDEX1) NE ' '
0084    ADD 1 TO #LEN
0085  ELSE
0086    ESCAPE BOTTOM
0087  END-IF
0088END-FOR
0089
0090/* Loop through each character */
0091FOR #INDEX1 = 1 TO #LEN
0092  FOR #INDEX2 = 1 TO 26
0093    IF #IN-ARRAY(#INDEX1) = #ALPHA(#INDEX2)
0094      ADD #POINT(#INDEX2) TO #TOTAL
0095      ESCAPE BOTTOM
0096    END-IF
0097  END-FOR
0098END-FOR
0099
0100WRITE 'WORD:' #IN-WORD
0101WRITE 'WORD LENGTH: ' #LEN
0102WRITE 'TOTAL SCORE: ' #TOTAL
0103END
