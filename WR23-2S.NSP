0003/** :author msh
0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 EMPLOYEES VIEW OF EMPLOYEES
0007  2 PERSONNEL-ID (A8) 
0008  2 FIRST-NAME (A20)
0009  2 NAME (A20)
0010  2 MAR-STAT (A1)
0011  2 GENDER (A1)
0012  2 CITY (A20)
0013  2 DEPT (A6)
0014  2 REDEFINE DEPT
0015    3 NEW-DEPT (A4)
0016  2 SALARY (P9.0/1:10)
0017  2 CURR-CODE (A3/1:10)
0018  2 BONUS (P9.0/1:10,1:10)
0019
00201 VEHICLES VIEW OF VEHICLES
0021  2 MAKE (A20)
0022
00231 #INCREASE (N5.2)
00241 #OLD-SALARY (P6)
00251 #NEW-SALARY (P6)
00261 #MAKE-ARRAY(A20/1:10) INIT (V)  <'MERCEDES' , 'AUSTIN', 'BMW' ,'FERRARI' , 'VOLVO' , 'MERCEDES-BENZ',  'CHYSLER' > 
00271 #VEHICLES (A20)
00281 #INDEX(N3)
0029
0030END-DEFINE
0031
0032DEFINE WORK FILE 1 'C:\Training\Salary increase 2.csv'
0033  TYPE 'csv'
0034
0035READ EMPLOYEES BY PERSONNEL-ID
0036
0037  MOVE 0.05  TO #INCREASE
0038
0039  DECIDE FOR EVERY CONDITION
0040    WHEN GENDER = 'F' ADD 0.02 TO #INCREASE
0041    WHEN GENDER = 'M' SUBTRACT 0.01 FROM #INCREASE
0042    WHEN MAR-STAT = 'S' OR MAR-STAT = 'D' ADD 0.01 TO #INCREASE
0043    WHEN NEW-DEPT = 'MGMT'  MOVE 0.05 TO #INCREASE
0044    WHEN NONE
0045      IGNORE
0046  END-DECIDE
0047
0048  RESET #VEHICLES
0049
0050  FIND VEHICLES WITH PERSONNEL-ID EQ EMPLOYEES.PERSONNEL-ID
0051
0052    EXAMINE #MAKE-ARRAY(*) FOR MAKE GIVING INDEX IN #INDEX
0053    IF #INDEX NE 0
0054      MOVE MAKE TO #VEHICLES
0055      RESET #INCREASE
0056      ESCAPE BOTTOM
0057    END-IF
0058
0059  END-FIND
0060  
0061  WRITE
0062    PERSONNEL-ID DEPT /
0063    CURR-CODE (1) SALARY (1)
0064    BONUS (1,1) BONUS (1,2) BONUS (1,3) BONUS (1,4) /
0065    CURR-CODE (2) SALARY (2)
0066    BONUS (2,1) BONUS (2,2) BONUS (2,3) BONUS (2,4) /
0067    CURR-CODE (3) SALARY (3)
0068    BONUS (3,1) BONUS (3,2) BONUS (3,3) BONUS (3,4) /
0069    CURR-CODE (4) SALARY (4)
0070    BONUS (4,1) BONUS (4,2) BONUS (4,3) BONUS (4,4) /
0071    CURR-CODE (5) SALARY (5)
0072    BONUS (5,1) BONUS (5,2) BONUS (5,3) BONUS (5,4) /
0073    CURR-CODE (6) SALARY (6)
0074    BONUS (6,1) BONUS (6,2) BONUS (6,3) BONUS (6,4) /
0075    CURR-CODE (7) SALARY (7)
0076    BONUS (6,1) BONUS (7,2) BONUS (7,3) BONUS (7,4) /
0077    CURR-CODE (8) SALARY (8)
0078    BONUS (7,1) BONUS (8,2) BONUS (8,3) BONUS (8,4) /
0079    CURR-CODE (9) SALARY (9)
0080    BONUS (9,1) BONUS (9,2) BONUS (9,3) BONUS (9,4) /
0081
0082  
0083
0084  MOVE SALARY(1) TO #OLD-SALARY
0085 COMPUTE #NEW-SALARY  = (#OLD-SALARY * #INCREASE) + #OLD-SALARY
0086 
0087******** SHIFT OCCURRENCES ********
0088  FOR #INDEX = 10 TO 2 STEP -1
0089    MOVE SALARY(#INDEX - 1)    TO SALARY(#INDEX)
0090    MOVE CURR-CODE(#INDEX - 1) TO CURR-CODE(#INDEX)
0091    MOVE BONUS(#INDEX - 1,*) TO BONUS(#INDEX,*)
0092  END-FOR
0093RESET  SALARY(1) BONUS(1,*)
0094******** CALCULATE NEW SALARY ********
0095  #OLD-SALARY := SALARY(2)
0096  #NEW-SALARY := #OLD-SALARY
0097  ADD (#OLD-SALARY * #INCREASE) TO #NEW-SALARY
0098 
0099******** STORE IN CURRENT YEAR (OCC 1) ********
0100  MOVE #NEW-SALARY TO SALARY(1)
0101  MOVE CURR-CODE(2) TO CURR-CODE(1)
0102
0103
0104   WRITE
0105    PERSONNEL-ID DEPT /
0106    CURR-CODE (1) SALARY (1)
0107    BONUS (1,1) BONUS (1,2) BONUS (1,3) BONUS (1,4) /
0108    CURR-CODE (2) SALARY (2)
0109    BONUS (2,1) BONUS (2,2) BONUS (2,3) BONUS (2,4) /
0110    CURR-CODE (3) SALARY (3)
0111    BONUS (3,1) BONUS (3,2) BONUS (3,3) BONUS (3,4) /
0112    CURR-CODE (4) SALARY (4)
0113    BONUS (4,1) BONUS (4,2) BONUS (4,3) BONUS (4,4) /
0114    CURR-CODE (5) SALARY (5)
0115    BONUS (5,1) BONUS (5,2) BONUS (5,3) BONUS (5,4) /
0116    CURR-CODE (6) SALARY (6)
0117    BONUS (6,1) BONUS (6,2) BONUS (6,3) BONUS (6,4) /
0118    CURR-CODE (7) SALARY (7)
0119    BONUS (6,1) BONUS (7,2) BONUS (7,3) BONUS (7,4) /
0120    CURR-CODE (8) SALARY (8)
0121    BONUS (7,1) BONUS (8,2) BONUS (8,3) BONUS (8,4) /
0122    CURR-CODE (9) SALARY (9)
0123    BONUS (9,1) BONUS (9,2) BONUS (9,3) BONUS (9,4) /
0124
0125 UPDATE
0126
0127END-READ
0128* end transaction
0129END
