0004/* TODO Enter your code here
0005***************************************************************
0006** Program displays employees information in a MAP 
0007** Sorted by Personel-id
0008** Uses keys for read direction
0009
0010**************************************************************
0011DEFINE DATA LOCAL 
0012
00131 EMPLOYEES VIEW OF EMPLOYEES
0014  2 PERSONNEL-ID (A8) 
0015  2 NAME (A20)
0016  2 ADDRESS-LINE (A20/1:2)
0017  2 CITY (A20)
0018  2 COUNTRY (A3)
0019
00201 #PROGRAM (A8)
0021
00221 #MAP
0023  2 PERSONNEL-ID (A8)
0024  2 NAME (A20)
0025  2 ADDRESS-LINE (A20/1:2)
0026  2 CITY (A20)
0027  2 COUNTRY (A3)
0028
00291 #DIRECTION (A1)  /* A = Ascending , D = Descending /*
0030
0031END-DEFINE
0032
0033SET KEY  
0034  PF3 NAMED 'EXIT'
0035  PF4 NAMED 'ASC'
0036  PF5 NAMED 'DESC'
0037*
0038MOVE *PROGRAM TO #PROGRAM
0039*
0040
0041#DIRECTION := 'A'
0042
0043    READ EMPLOYEES IN DYNAMIC #DIRECTION BY PERSONNEL-ID
0044    
0045      MOVE  BY NAME EMPLOYEES TO #MAP /*map fields 
0046*
0047      INPUT USING MAP "TESTMAP2" 
0048
0049*   
0050      IF *PF-KEY = 'PF3' ESCAPE MODULE END-IF
0051      IF *PF-KEY = 'PF4' MOVE 'A' TO #DIRECTION END-IF
0052      IF *PF-KEY = 'PF5' MOVE 'D' TO #DIRECTION END-IF
0053
0054
0055    END-READ
0056
0057
0058END
