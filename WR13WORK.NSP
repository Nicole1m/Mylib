0005DEFINE DATA LOCAL
00061 #COUNTRIES (A100)
00071 #NUMBER (A5)
00081 #COUNTRY-NAME  (A30)
00091 #POPULATION (A15)
00101 #REGION (A20)
0011END-DEFINE
0012* 
0013FORMAT PS= 100
0014FORMAT LS =200
0015*
0016DEFINE WORK FILE 1 'C:\Training\afr-countries.txt'
0017*
0018RD1. READ WORK 1 #COUNTRIES
0019
0020  SEPARATE #COUNTRIES
0021    INTO #NUMBER 
0022    #COUNTRY-NAME 
0023    #POPULATION 
0024    #REGION 
0025    WITH DELIMITER '#'
0026
0027  EXAMINE #POPULATION
0028    FOR ','
0029  DELETE
0030  MOVE RIGHT #POPULATION TO #POPULATION
0031
0032  DISPLAY
0033    #NUMBER 
0034    #COUNTRY-NAME
0035    #POPULATION
0036    #REGION
0037
0038  AT END OF DATA
0039    WRITE 'Total countries:'
0040      COUNT (#COUNTRIES)
0041  END-ENDDATA
0042
0043END-WORK
0044
0045END
