0001/** New Program WR23SAL.
0002/**
0003/** :author msh
0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 EMPLOYEES VIEW OF EMPLOYEES
0007  2 PERSONNEL-ID (A8) 
0008  2 FIRST-NAME (A20)
0009  2 NAME (A20)
0010  2 MAR-STAT (A1)
0011  2 GENDER (A1)
0012  2 CITY (A20)
0013  2 DEPT (A6)
0014  2 REDEFINE DEPT
0015    3 NEW-DEPT (A4)
0016  2 SALARY (P9.0/1:1)
0017
00181 VEHICLES VIEW OF VEHICLES
0019  2 MAKE (A20)
0020
00211 #INCREASE (N5.2)
00221 #OLD-SALARY (P6/1:1)
00231 #NEW-SALARY (P6/1:1)
00241 #MAKE-ARRAY(A20/1:10) INIT (V)  <'MERCEDES' , 'AUSTIN', 'BMW' ,'FERRARI' , 'VOLVO' , 'MERCEDES-BENZ',  'CHYSLER' > 
00251 #VEHICLES (A20)
00261 #INDEX(N3)
0027END-DEFINE
0028
0029DEFINE WORK FILE 1 'C:\Training\Salary increase.csv'
0030  TYPE 'csv'
0031
0032READ EMPLOYEES BY PERSONNEL-ID
0033
0034  MOVE 0.05  TO #INCREASE
0035
0036  DECIDE FOR EVERY CONDITION
0037    WHEN GENDER = 'F' ADD 0.02 TO #INCREASE
0038    WHEN GENDER = 'M' SUBTRACT 0.01 FROM #INCREASE
0039    WHEN MAR-STAT = 'S' OR MAR-STAT = 'D' ADD 0.01 TO #INCREASE
0040    WHEN NEW-DEPT = 'MGMT'  MOVE 0.05 TO #INCREASE
0041    WHEN NONE
0042      IGNORE
0043  END-DECIDE
0044
0045  RESET #VEHICLES
0046
0047  FIND VEHICLES WITH PERSONNEL-ID EQ EMPLOYEES.PERSONNEL-ID
0048  
0049    EXAMINE #MAKE-ARRAY(*) FOR MAKE GIVING INDEX IN #INDEX
0050    IF #INDEX NE 0
0051      MOVE MAKE TO #VEHICLES
0052      RESET #INCREASE
0053      ESCAPE BOTTOM
0054    END-IF
0055
0056  END-FIND
0057
0058  MOVE SALARY(1) TO #OLD-SALARY(1)
0059 COMPUTE #NEW-SALARY(1)  = (#OLD-SALARY(1) * #INCREASE) + #OLD-SALARY(1)
0060
0061
0062  WRITE WORK FILE 1 VARIABLE 
0063    PERSONNEL-ID
0064    FIRST-NAME
0065    NAME
0066    GENDER
0067    MAR-STAT
0068    CITY
0069    NEW-DEPT
0070    #OLD-SALARY(1)
0071    #INCREASE
0072    #NEW-SALARY(1)
0073    #VEHICLES
0074
0075END-READ
0076
0077END
