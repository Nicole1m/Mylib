0005DEFINE DATA LOCAL
0006
00071 EMPLOYEES VIEW OF EMPLOYEES
0008  2 PERSONNEL-ID (A8)
0009  2 COUNTRY (A3)
00101 #COUNT (N5)
00111 #ET-CNT (N5)
00121 #UPDATE-CNT (N5)
0013END-DEFINE
0014
0015RD1. READ EMPLOYEES BY PERSONNEL-ID 
0016
0017  ADD 1 TO #COUNT
0018  DECIDE ON FIRST VALUE COUNTRY
0019    VALUE 'D' MOVE 'GER' TO COUNTRY
0020    VALUE 'DK'  MOVE 'DNK' TO COUNTRY
0021    VALUE 'F' MOVE 'FRA' TO COUNTRY
0022    VALUE 'E' MOVE 'ESP' TO COUNTRY
0023    ANY 
0024      ADD 1 TO #UPDATE-CNT
0025      UPDATE (RD1.)
0026      ADD 1 TO #ET-CNT
0027      IF #ET-CNT > 50
0028        END TRANSACTION
0029        RESET #ET-CNT
0030      END-IF
0031    NONE
0032      IGNORE
0033  END-DECIDE
0034
0035
0036END-READ
0037END TRANSACTION
0038
0039WRITE ' COUNT:' #COUNT /
0040
0041END
