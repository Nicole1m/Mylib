0005DEFINE DATA LOCAL
0006/*( imported data fields from Data Definition Module EMPLOYEES
00071 EMPLOYEES VIEW OF EMPLOYEES
0008  2 PERSONNEL-ID (A8) 
0009  2 NAME (A20)
0010  2 CITY (A20)
00111 CTY-1 (A20) CONST <'DERBY'>
0012END-DEFINE
0013*
0014FORMAT LS=150 
0015FORMAT PS=50
0016*
0017F1.  FIND EMPLOYEES WITH 
0018    EMPLOYEES.CITY EQ CTY-1
0019*
0020  IF NO RECORD FOUND
0021    WRITE 'NO RECORDS FOUND'
0022    ESCAPE BOTTOM (F1.)
0023  END-NOREC
0024
0025
0026  DISPLAY *ISN 
0027    EMPLOYEES.PERSONNEL-ID
0028    EMPLOYEES.NAME (AL=10)
0029    EMPLOYEES.CITY (AL=10)
0030
0031    'Number' *NUMBER
0032    'Counter' *COUNTER
0033
0034END-FIND
0035END
