0060********************** USING FOR LOOP********************************
0061
0062DEFINE DATA
0063LOCAL
00641 EMPLOYEES VIEW OF EMPLOYEES
0065  2 PERSONNEL-ID (A8)
0066  2 CITY (A20)
00671 #CITY (A20/1:16) INIT < 'ALICANTE', 'BARCELONA', 'BILBAO', 'BREMEN', 'BURTON-ON-TRENT',
0068'DARMSTADT', 'DERBY' , 'FRANKFURT', 'GRIESHEIM', 'KOEBENHAVN', 'MADRID', 'MUENCHEN',
0069  'NOTTINGHAM', 'PARIS', 'STUTTGART', 'TROYES' >
0070
00711 #TOTAL (N5/1:16)
00721 #INDEX (N5) 
0073END-DEFINE
0074
0075
0076
0077FOR #INDEX 1 TO 16
0078  FIND NUMBER EMPLOYEES WITH CITY EQ  #CITY(#INDEX)
0079  MOVE *NUMBER TO #TOTAL(#INDEX)
0080
0081END-FOR
0082INPUT USING MAP "WK47P-2" 
0083END
