0023*
0024DEFINE WORK FILE 1 'C:\Training\Employees-Summary.txt'
0025* 
0026
0027READ EMPLOYEES 
0028* GENDER
0029  DECIDE ON FIRST GENDER
0030    VALUE 'F'
0031      ADD 1 TO GENDER-F
0032
0033    VALUE 'M'
0034      ADD 1 TO GENDER-M
0035
0036    VALUE ' '
0037      ADD 1 TO GENDER-EMPTY
0038
0039    NONE
0040      ADD 1 TO GENDER-NONE
0041      IGNORE
0042  END-DECIDE
0043
0044  WRITE WORK FILE 1 'FEMALE:'    GENDER-F
0045  WRITE WORK FILE 1 'MALE:  '    GENDER-M
0046  WRITE WORK FILE 1 'EMPTY  '    GENDER-EMPTY
