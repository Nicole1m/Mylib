0001/** New Program WR17-2CI.
0002/**
0003/** :author msh
0004/* TODO Enter your code here
0005DEFINE DATA LOCAL 
0006
00071 EMPLOYEES VIEW OF EMPLOYEES
0008  2 CITY (A20)
0009  2 LANG (A3/1:12)
0010  2 C*LANG(N3)
00111 #CITY (A20/1:16) INIT (V) < 'GRIESHEIM' , 'MUENCHEN' , 'STUTTGART', 'BILBAO',
0012'BURTON-ON-TRENT' , 'KOEBENHAVN' ,  'ALICANTE', 'TROYES' , 'BREMEN' , 'PARIS' ,
0013'BARCELONA' , 'DARMSTADT', 'NOTTINGHAM', 'MADRID' , 'FRANKFURT' , 'DERBY' >
00141 #LANG(A3/1:16,1:12)
00151 #INDEX (N7)
00161 #INDEX2 (N7)
00171 #INDEX-LANG(N4)
00181 #TOTAL (N5/1:16)
0019END-DEFINE
0020
0021
0022FOR #INDEX 1 TO 16
0023
0024  FIND EMPLOYEES WITH CITY EQ #CITY(#INDEX)
0025  MOVE *NUMBER TO #TOTAL(#INDEX) 
0026   FOR #INDEX-LANG = 1 TO C*LANG
0027    FOR #INDEX2 = 1 TO 12
0028      IF #LANG(#INDEX, #INDEX2) = ' '
0029        MOVE LANG(#INDEX-LANG) TO #LANG(#INDEX,#INDEX2)
0030        ESCAPE BOTTOM
0031      ELSE
0032        IF LANG(#INDEX-LANG) = #LANG(#INDEX, #INDEX2)
0033          ESCAPE BOTTOM
0034        END-IF
0035      END-IF
0036
0037    END-FOR
0038END-FOR
0039  END-FIND
0040END-FOR
0041
0042 INPUT USING MAP "WR17-2MA"
0043END
