0005DEFINE DATA LOCAL 
00061 #SORTED-WORDS (A40)
00071 #NO-DUPS (A40)
0008END-DEFINE
0009
0010DEFINE WORK FILE 1 'C:\Training\english words sorted.txt'
0011DEFINE WORK FILE 2 'C:\Training\english words no dups.txt'
0012
0013
0014READ WORK 1 #SORTED-WORDS
0015
0016  IF #SORTED-WORDS NE #NO-DUPS
0017    MOVE #SORTED-WORDS TO #NO-DUPS
0018
0019    WRITE WORK 2 #NO-DUPS 
0020
0021  END-IF
0022
0023END-WORK
0024
0025END
