0003/** :author msh
0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
00061 #WORDS (A26)
00071 REDEFINE #WORDS
0008  2 #WORDS-ARRAY (A1/1:26)
00091 #POINT (N2/1:26)
00101 #ALPHA (A1/1:26)
00111 #INDEX1 (N5)
00121 #INDEX2 (N5)
00131 #TOTAL (N5)
00141 #START-TIME (T)
00151 #END-TIME (T)
00161 #BIGGEST (N2)
0017END-DEFINE
0018*
0019ST. SETTIME                                                      
0020WRITE 'START TIME:' *TIME 
0021
0022
0023DEFINE WORK FILE 1 'C:\Training\6 letter words.txt'
0024DEFINE WORK FILE 2 'C:\Training\6 letter words-scrabble.txt'
0025*
0026/* Initialize alphabet */
0027MOVE 'A' TO #ALPHA (1)
0028MOVE 'B' TO #ALPHA (2)
0029MOVE 'C' TO #ALPHA (3)
0030MOVE 'D' TO #ALPHA (4)
0031MOVE 'E' TO #ALPHA (5)
0032MOVE 'F' TO #ALPHA (6)
0033MOVE 'G' TO #ALPHA (7)
0034MOVE 'H' TO #ALPHA (8)
0035MOVE 'I' TO #ALPHA (9)
0036MOVE 'J' TO #ALPHA (10)
0037MOVE 'K' TO #ALPHA (11)
0038MOVE 'L' TO #ALPHA (12)
0039MOVE 'M' TO #ALPHA (13)
0040MOVE 'N' TO #ALPHA (14)
0041MOVE 'O' TO #ALPHA (15)
0042MOVE 'P' TO #ALPHA (16)
0043MOVE 'Q' TO #ALPHA (17)
0044MOVE 'R' TO #ALPHA (18)
0045MOVE 'S' TO #ALPHA (19)
0046MOVE 'T' TO #ALPHA (20)
0047MOVE 'U' TO #ALPHA (21)
0048MOVE 'V' TO #ALPHA (22)
0049MOVE 'W' TO #ALPHA (23)
0050MOVE 'X' TO #ALPHA (24)
0051MOVE 'Y' TO #ALPHA (25)
0052MOVE 'Z' TO #ALPHA (26)
0053
0054/* Scrabble Points */
0055MOVE 1  TO #POINT (1)   /* A */
0056MOVE 3  TO #POINT (2)   /* B */
0057MOVE 3  TO #POINT (3)   /* C */
0058MOVE 2  TO #POINT (4)   /* D */
0059MOVE 1  TO #POINT (5)   /* E */
0060MOVE 4  TO #POINT (6)   /* F */
0061MOVE 2  TO #POINT (7)   /* G */
0062MOVE 4  TO #POINT (8)   /* H */
0063MOVE 1  TO #POINT (9)   /* I */
0064MOVE 8  TO #POINT (10)  /* J */
0065MOVE 5  TO #POINT (11)  /* K */
0066MOVE 1  TO #POINT (12)  /* L */
0067MOVE 3  TO #POINT (13)  /* M */
0068MOVE 1  TO #POINT (14)  /* N */
0069MOVE 1  TO #POINT (15)  /* O */
0070MOVE 3  TO #POINT (16)  /* P */
0071MOVE 10 TO #POINT (17)  /* Q */
0072MOVE 1  TO #POINT (18)  /* R */
0073MOVE 1  TO #POINT (19)  /* S */
0074MOVE 1  TO #POINT (20)  /* T */
0075MOVE 1  TO #POINT (21)  /* U */
0076MOVE 4  TO #POINT (22)  /* V */
0077MOVE 4  TO #POINT (23)  /* W */
0078MOVE 8  TO #POINT (24)  /* X */
0079MOVE 4  TO #POINT (25)  /* Y */
0080MOVE 10 TO #POINT (26)  /* Z */
0081
0082*
0083
0084READ WORK 1 #WORDS
0085
0086  EXAMINE #WORDS TRANSLATE INTO UPPER
0087
0088*
0089  FOR #INDEX1 = 1 TO 6
0090    FOR #INDEX2 = 1 TO 26
0091      IF #WORDS-ARRAY(#INDEX1) EQ #ALPHA(#INDEX2)
0092        ADD #POINT(#INDEX2) TO #TOTAL
0093        ESCAPE BOTTOM
0094      END-IF
0095    END-FOR
0096  END-FOR
0097
0098  IF #BIGGEST LT #TOTAL
0099    MOVE #TOTAL TO #BIGGEST
0100  END-IF
0101  
0102   WRITE WORK FILE 2 #WORDS #TOTAL 
0103  
0104  RESET #TOTAL
0105
0106
0107END-WORK
0108
0109WRITE  'END TIME:  ' *TIME 
0110WRITE 'BIGGEST=' #BIGGEST
0111END
