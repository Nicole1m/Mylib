0067*
0068DEFINE WORK FILE 1 'C:\Training\Countries in Africa.txt'
0069
0070MOVE #IN-COUNTRY(*) TO #OUT-COUNTRY(*)
0071
0072FOR #OUTER = 54 TO 1 STEP -1
0073  FOR #INNER = 1 TO 53
0074    IF #IN-COUNTRY (#INNER) GT #IN-COUNTRY (#INNER + 1)
