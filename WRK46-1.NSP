0076      MOVE #IN-COUNTRY(#INNER + 1) TO #IN-COUNTRY (#INNER)
0077      MOVE #SAVE-COUNTRY TO #IN-COUNTRY (#INNER + 1)
0078    END-IF
0079  END-FOR
0080END-FOR
0081
0082*
0083WRITE WORK FILE 1 VARIABLE 'Original'        'Sorted'                
