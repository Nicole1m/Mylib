0001/** New Program WR41REST.
0002/**
0003/** :author msh
0004/* TODO Enter your code here
0005DEFINE DATA LOCAL 
00061 EMPLOYEES VIEW OF EMPLOYEES
0007  2 PERSONNEL-ID (A8)  
0008  2 NAME (A20)
0009  2 CITY (A20)
0010
00111 #SELECT (A1/1:16)
00121 RESTART-VALUE (A20)
00131 #START-VALUE (A20)
00141 #SEARCH-NAME (A20)
0015
00161 #PERSONNEL-ID (A8/1:16)
00171 #NAME          (A20/1:16)
00181 #GENDER        (A1/1:16)
00191 #CITY          (A20/1:16) 
0020
00211 #I             (N3)
00221 #SEL-INDEX (N3)
00231 #CV-SELECT (C/1:16)
0024
0025END-DEFINE 
0026
0027SET CONTROL 'MT'
0028SET KEY 
0029PF1 = HELP
0030PF3 NAMED 'EXIT'
0031PF8 NAMED 'NEXT' 
0032
0033READ EMPLOYEES WITH REPOSITION
0034    BY NAME
0035    STARTING FROM #START-VALUE
0036
0037  ADD 1 TO #I
0038
0039  #PERSONNEL-ID(#I) := PERSONNEL-ID 
0040  #NAME(#I)          := NAME
0041  #CITY(#I)          := CITY
0042
0043  IF #I = 16
0044  
0045  
0046    INPUT USING MAP "WR41RESM" 
0047    
0048    DECIDE ON FIRST VALUE OF *PF-KEY
0049        VALUE 'PF3'
0050          ESCAPE MODULE
0051        VALUE 'PF8'
0052          ESCAPE BOTTOM
0053        VALUE 'ENTR'
0054          IGNORE
0055        NONE
0056          REINPUT WITH TEXT 'Use a valid function keys'
0057      END-DECIDE
0058
0059
0060    FOR #SEL-INDEX = 1 TO 16
0061      IF #SELECT(#SEL-INDEX) = 'A'
0062        CALLNAT 'WR41SUB' #PERSONNEL-ID(#SEL-INDEX)
0063        RESET #SELECT(#SEL-INDEX)  
0064      END-IF
0065      
0066      IF #SELECT(#SEL-INDEX) = 'V'
0067        CALLNAT "WR41V" #PERSONNEL-ID(#SEL-INDEX) #NAME(#SEL-INDEX)
0068        RESET #SELECT(#SEL-INDEX)
0069      END-IF 
0070      
0071      IF #SELECT(#SEL-INDEX) = 'C'
0072      CALLNAT "WR41COM" #PERSONNEL-ID(#SEL-INDEX)
0073        RESET #SELECT(#SEL-INDEX) 
0074      END-IF  
0075    
0076     IF #SELECT(#SEL-INDEX) = 'P'
0077     CALLNAT "WR41-PER" #PERSONNEL-ID(#SEL-INDEX)
0078        RESET #SELECT(#SEL-INDEX) 
0079      END-IF  
0080     
0081    END-FOR 
0082   
0083    IF RESTART-VALUE NE ' '
0084      MOVE RESTART-VALUE TO #START-VALUE #SEARCH-NAME
0085      RESET RESTART-VALUE
0086      RESET #I
0087     ESCAPE TOP REPOSITION
0088      ESCAPE BOTTOM
0089    END-IF
0090   
0091
0092
0093    RESET #I
0094   
0095
0096  END-IF 
0097END-READ
0098
0099IF #I < 16
0100
0101  RESET
0102    #PERSONNEL-ID(#I + 1:16 )
0103    #NAME(#I + 1:16)
0104    #CITY(#I + 1:16) 
0105MOVE (AD=P) TO #CV-SELECT(#I + 1:16)
0106  INPUT USING MAP "WR41RESM"
0107  
0108END-IF
0109END
