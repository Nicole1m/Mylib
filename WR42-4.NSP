0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
0006
00071 EMPLOYEES VIEW OF EMPLOYEES
0008  2 PERSONNEL-ID (A8) 
0009  2 FIRST-NAME (A20)
0010  2 NAME (A20)
0011  2 MAR-STAT (A1)
0012  2 GENDER (A1)
0013  2 ADDRESS-LINE (A20/1:2)
0014  2 CITY (A20)
0015  2 POST-CODE (A10)
0016  2 COUNTRY (A3)
0017  2 DEPT (A6)
0018  2 JOB-TITTLE (A25)
0019  2 LANG (A3/1:5)
0020
00211 #PERSONNEL-ID (N8)
00221 #ADDRESS (A20/1:2)
00231 #CITY (A20)
00241 #COUNTRY (A3)
00251 #DEPARTMENT (A6)
00261 #FIRST-NAME (A20)
00271 #GENDER (A1)
00281 #JOB-TITLE (A25)
00291 #LANGUAGE (A4/1:5)
00301 #MARITAL-STATUS (A1)
00311 #NAME (A20)
00321 #POSTAL-CODE (A10)
0033
0034END-DEFINE
0035
0036SET CONTROL 'MT'
0037SET KEY  
0038  PF1 = HELP
0039  PF3 NAMED 'EXIT'
0040  PF8 NAMED 'NEXT'
0041
0042RD1. READ(1) EMPLOYEES IN DESCENDING BY PERSONNEL-ID
0043UPDATE(RD1.)
0044
0045 IF PERSONNEL-ID IS (N8)
0046    #PERSONNEL-ID := VAL(PERSONNEL-ID)
0047    ADD 1 TO #PERSONNEL-ID
0048  END-IF
0049  
0050  INPUT USING MAP "WR42-4AD"
0051  
0052  DECIDE ON FIRST VALUE OF *PF-KEY
0053    VALUE 'PF3'
0054      ESCAPE MODULE
0055    VALUE 'PF8'
0056      ESCAPE BOTTOM
0057    VALUE 'ENTR'
0058      IGNORE
0059    NONE
0060      REINPUT WITH TEXT 'USE A VALID FUNCTION KEY'
0061  END-DECIDE
0062
0063  IF #NAME = ' '
0064    REINPUT ' ALL FIELDS MUST BE ENTERED'
0065      MARK *#NAME
0066  END-IF 
0067
0068  IF #FIRST-NAME = ' '
0069    REINPUT ' ALL FIELDS MUST BE ENTERED'
0070      MARK *#FIRST-NAME
0071  END-IF
0072
0073  IF #DEPARTMENT = ' '
0074    REINPUT ' ALL FIELDS MUST BE ENTERED'
0075      MARK *#DEPARTMENT
0076  END-IF
0077
0078  IF #JOB-TITLE = ' '
0079    REINPUT ' ALL FIELDS MUST BE ENTERED'
0080      MARK *#JOB-TITLE
0081  END-IF
0082
0083  IF #ADDRESS(1) = ' '
0084    REINPUT ' ALL FIELDS MUST BE ENTERED'
0085      MARK *#ADDRESS(1)
0086  END-IF 
0087
0088  IF #CITY = ' '
0089    REINPUT ' ALL FIELDS MUST BE ENTERED'
0090      MARK *#CITY
0091  END-IF 
0092
0093  IF #COUNTRY = ' '
0094    REINPUT ' ALL FIELDS MUST BE ENTERED'
0095      MARK *#COUNTRY
0096  END-IF 
0097
0098  IF #POSTAL-CODE  = ' '
0099    REINPUT ' ALL FIELDS MUST BE ENTERED'
0100      MARK *#POSTAL-CODE
0101  END-IF 
0102
0103  IF #LANGUAGE(1)  = ' '
0104    REINPUT ' ALL FIELDS MUST BE ENTERED'
0105      MARK *#LANGUAGE(1)
0106  END-IF 
0107
0108
0109  IF #GENDER = ' '
0110    REINPUT 'ALL FIELDS MUST BE ENTERED'
0111  END-IF
0112
0113  IF #MARITAL-STATUS = ' '
0114    REINPUT 'ALL FIELDS MUST BE ENTERED'
0115      MARK *#MARITAL-STATUS
0116  END-IF
0117
0118  IF  NOT ( #MARITAL-STATUS = 'M' OR = 'S' OR ='W' OR = 'D')
0119    REINPUT
0120'INVALID MARITAL STATUS , PLEASE ENTER-  M, S , W , D'
0121      MARK *#MARITAL-STATUS
0122    RESET #MARITAL-STATUS
0123  END-IF
0124  
0125  
0126   IF  NOT ( #GENDER = 'M' OR = 'F' )
0127    REINPUT 
0128      ' INVALID GENDER , PLEASE ENTER M-MALE , F-FEMALE'
0129      MARK *#GENDER
0130  END-IF
0131  
0132PERSONNEL-ID := #PERSONNEL-ID
0133FIRST-NAME  := #FIRST-NAME
0134NAME := #NAME
0135MAR-STAT := #MARITAL-STATUS
0136GENDER := #GENDER
0137ADDRESS-LINE(*) := #ADDRESS(*)
0138CITY := #CITY
0139POST-CODE := #POSTAL-CODE
0140COUNTRY := #COUNTRY
0141DEPT := #DEPARTMENT
0142JOB-TITTLE := #JOB-TITLE
0143LANG(*) := #LANGUAGE(*)
0144  
0145 STORE RECORD IN EMPLOYEES 
0146  
0147END-READ
0148
0149 INPUT USING MAP "WR42-4M2"
0150
0151* END TRANSACTION 
0152
0153END
