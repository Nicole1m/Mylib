0004/* TODO Enter your code here
0005DEFINE DATA 
0006PARAMETER
00071 #GENDER-DESCR (A10)
00081 GENDER (A1)
0009
0010LOCAL
00111 #SELECT (A1/1:2)
0012
0013END-DEFINE
0014
0015INPUT USING MAP 'WR41HGEN'
0016
0017IF *PF-KEY = 'PF3'
0018  ESCAPE MODULE
0019END-IF
0020
0021DECIDE FOR FIRST CONDITION
0022  WHEN #SELECT(1) NE ' '
0023    MOVE 'M' TO GENDER
0024    MOVE 'MALE' TO #GENDER-DESCR
0025    
0026  
0027  WHEN #SELECT(2) NE ' ' 
0028    MOVE 'F' TO GENDER
0029    MOVE 'FEMALE' TO #GENDER-DESCR
0030    
0031  WHEN  NONE
0032    REINPUT ' Please select one option with "X"'
0033
0034END-DECIDE
0035
0036
0037END
