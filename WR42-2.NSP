0005DEFINE DATA LOCAL
0006
00071 EMPLOYEES VIEW OF EMPLOYEES
0008  2 PERSONNEL-ID (A8) 
0009  2 REDEFINE PERSONNEL-ID
0010    3 NEW-ID (N1)
0011  2 COUNTRY (A3)
00121 #COUNTRY-ARRAY(A3/1:6)
00131 #COUNT (N5)
0014END-DEFINE
0015
0016RD1. READ EMPLOYEES BY PERSONNEL-ID 
0017
0018  DECIDE ON FIRST VALUE NEW-ID
0019    VALUE 1 MOVE COUNTRY TO #COUNTRY-ARRAY(NEW-ID)
0020    VALUE 2 MOVE COUNTRY TO #COUNTRY-ARRAY(NEW-ID)
0021    VALUE 3 MOVE COUNTRY TO #COUNTRY-ARRAY(NEW-ID)
0022    VALUE 4 MOVE COUNTRY TO #COUNTRY-ARRAY(NEW-ID)
0023    VALUE 5 MOVE COUNTRY TO #COUNTRY-ARRAY(NEW-ID)
0024    VALUE 6 MOVE COUNTRY TO #COUNTRY-ARRAY(NEW-ID)
0025    NONE
0026      IGNORE
0027  END-DECIDE 
0028 
0029END-READ
0030FOR NEW-ID = 1 TO 6
0031WRITE NEW-ID #COUNTRY-ARRAY(NEW-ID)
0032END-FOR
0033END
