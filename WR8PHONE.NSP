0005DEFINE DATA LOCAL 
0006
00071 EMPLOYEES VIEW OF EMPLOYEES
0008  2 PERSONNEL-ID (A8) 
0009  2 NAME (A20)
0010  2 GENDER (A1)
0011  2 COUNTRY (A3)
0012
00131 #NEW-NAME (A20)
0014END-DEFINE
0015
0016REPEAT
0017  INPUT
0018    ' Enter your name:' #NEW-NAME (AD=M)
0019
0020  IF #NEW-NAME = '#'
0021    ESCAPE BOTTOM
0022  END-IF
0023
0024  FIND EMPLOYEES WITH  PHONETIC-NAME = #NEW-NAME
0025
0026    DISPLAY *ISN
0027      EMPLOYEES.PERSONNEL-ID
0028      EMPLOYEES.NAME
0029      EMPLOYEES.GENDER
0030      EMPLOYEES.COUNTRY
0031
0032  END-FIND
0033END-REPEAT
0034END
