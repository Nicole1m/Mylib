0007DEFINE DATA LOCAL
00081 #BIRTH-RATE (A200)
00091 #POSITION (A4)
00101 #YEAR (A4)
00111 #COUNTRY (A80)
00121 #RATE (A20)
0013
0014END-DEFINE
0015
0016DEFINE WORK FILE 1 'C:\Training\BIRTH-RATE.txt'
0017DEFINE WORK FILE 2 'C:\Training\Sorted Birth-rate .txt'
0018
0019READ WORK FILE 1 #BIRTH-RATE
0020
0021  SEPARATE #BIRTH-RATE INTO
0022    #POSITION
0023    #YEAR
0024    #COUNTRY
0025    #RATE
0026    WITH DELIMITER '#'
0027
0028  MOVE RIGHT #POSITION TO #POSITION
0029  MOVE RIGHT #RATE TO #RATE
0030
0031END-ALL
0032SORT BY #COUNTRY #YEAR USING #POSITION #RATE
0033
0034  WRITE WORK FILE 2  
0035    #YEAR ' '
0036    #COUNTRY ' '
0037    #POSITION ' '
0038    #RATE
0039END-SORT
0040
0041
