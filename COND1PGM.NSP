0004/* TODO Enter your code here
0005DEFINE DATA LOCAL 
00061 NUMVALUE (N20) INIT <0>
00071 MESSAGE ( A50) 
0008END-DEFINE
0009*
0010INPUT 'Enter a value from 0 to 20' NUMVALUE 
0011*
0012WRITE MESSAGE
0013DECIDE FOR FIRST CONDITION 
0014  WHEN NUMVALUE GE 1 AND NUMVALUE LE 3
0015    MESSAGE := ' value is 1,2,3' 
0016
0017  WHEN NUMVALUE = 5
0018    MESSAGE := ' value is 5'
0019
0020  WHEN NUMVALUE = 7
0021      OR NUMVALUE = 8
0022      OR NUMVALUE = 10
0023    MESSAGE := 'value is 7,8,10'
0024
0025  WHEN NUMVALUE = 13
0026      OR NUMVALUE GE 15 AND NUMVALUE LE 18
0027    MESSAGE := ' value is 13 , or is in the range of 15 to 18' 
0028
0029  WHEN NONE
0030    MESSAGE := ' invalid value'
0031
0032END-DECIDE
0033
0034WRITE MESSAGE
0035
0036END
