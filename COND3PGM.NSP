0005DEFINE DATA LOCAL 
00061 NUMVALUE (N20) INIT <10>
00071 MESSAGE ( A50) 
0008END-DEFINE
0009
0010*
0011FOR NUMVALUE =1 TO 20
0012  DECIDE FOR EVERY CONDITION
0013    WHEN NUMVALUE = 1 THRU 3
0014      MESSAGE := ' value is 1,2,3'
0015
0016    WHEN NUMVALUE = 5
0017      MESSAGE := ' value is 5'
0018
0019    WHEN NUMVALUE = 7 OR =8 OR =10
0020      MESSAGE := 'value is 7,8,10'
0021
0022    WHEN NUMVALUE = 13 OR =15 THRU 18
0023      MESSAGE := ' value is 13 , or is in the range of 15 to 18'
0024
0025    WHEN NONE
0026      MESSAGE := ' invalid value'
0027
0028  END-DECIDE
0029  WRITE 'The value is =' NUMVALUE
0030  WRITE MESSAGE
0031  
0032END-FOR
0033
0034END
