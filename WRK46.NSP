0005DEFINE DATA LOCAL 
0006
00071 EMPLOYEES VIEW OF EMPLOYEES
0008  2 PERSONNEL-ID (A8) 
0009  2 FIRST-NAME (A20)
0010  2 NAME (A20)
0011  2 ADDRESS-LINE (A20/1:1)
0012  2 CITY (A20)
0013  2 POST-CODE (A10)
0014  2 COUNTRY (A3)
0015  2 DEPT (A6)
0016
0017
00181 #EMP-ARRAY (1:*)
0019  2 PERSONNEL-ID (A8)
0020  2 FIRST-NAME   (A20)
0021  2 NAME         (A20)
0022  2 ADDRESS-LINE (A20/1:1)
0023  2 CITY         (A20)
0024  2 POST-CODE    (A10)
0025  2 COUNTRY      (A3)
0026
0027
00281 #TEMP-RECORD
0029  2 PERSONNEL-ID (A8)
0030  2 FIRST-NAME   (A20)
0031  2 NAME         (A20)
0032  2 ADDRESS-LINE (A20/1:1)
0033  2 CITY         (A20)
0034  2 POST-CODE    (A10)
0035  2 COUNTRY      (A3)
0036
0037
00381 #INDEX (N5)
00391 #INNER (N5)
00401 #OUTER (N5)
0041
0042END-DEFINE
0043
0044
0045**** USE FIND NUMBER TO SIZE UP YOUR X-ARRAY
0046FIND NUMBER EMPLOYEES WITH DEPT = 'MGMT30'
0047#INDEX := *NUMBER
0048RESIZE ARRAY #EMP-ARRAY TO (1:#INDEX)
0049RESET #INDEX
0050
0051
0052FIND EMPLOYEES WITH DEPT = 'MGMT30'
0053
0054  ADD 1 TO #INDEX
0055  MOVE BY NAME EMPLOYEES TO #EMP-ARRAY(#INDEX)
0056
0057END-FIND
0058
0059**********BUBBLE SORT USING FIRST NAME
0060
0061FOR #OUTER = #INDEX TO 1 STEP -1
0062  FOR #INNER = 1 TO (#INDEX - 1)
0063 IF #EMP-ARRAY.FIRST-NAME (#INNER) GT #EMP-ARRAY.FIRST-NAME (#INNER + 1)
0064      MOVE BY NAME #EMP-ARRAY(#INNER) TO #TEMP-RECORD
0065      MOVE BY NAME #EMP-ARRAY (#INNER + 1) TO #EMP-ARRAY (#INNER)
0066      MOVE BY NAME #TEMP-RECORD TO #EMP-ARRAY (#INNER + 1)
0067    END-IF
0068  END-FOR
0069END-FOR
0070
0071
0072FOR #INNER = 1 TO #INDEX
0073  WRITE
0074    #EMP-ARRAY.PERSONNEL-ID (#INNER) /
0075    #EMP-ARRAY.FIRST-NAME (#INNER) /
0076    #EMP-ARRAY.NAME (#INNER) /
0077    #EMP-ARRAY.ADDRESS-LINE(#INNER,1:1) /
0078    #EMP-ARRAY.CITY (#INNER) /
0079    #EMP-ARRAY.POST-CODE (#INNER) /
0080    #EMP-ARRAY.COUNTRY (#INNER) /
0081
0082END-FOR 
0083WRITE  #INDEX
0084END
