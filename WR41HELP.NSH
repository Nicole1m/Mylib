0005DEFINE DATA 
0006PARAMETER
00071 #MAR-DESCR (A10)
00081 MAR-STAT (A1)
0009
0010LOCAL
00111 #SELECT (A1/1:4)
00121 #INDEX (N1)
0013
0014
0015END-DEFINE
0016
0017
0018
0019INPUT USING MAP "WR41HMAP"
0020
0021IF *PF-KEY = 'PF3'
0022  ESCAPE MODULE
0023END-IF
0024
0025DECIDE FOR FIRST CONDITION
0026  WHEN #SELECT(1) NE ' '
0027    MOVE 'W' TO MAR-STAT
0028    MOVE 'WIDOWED' TO #MAR-DESCR
0029    
0030  
0031  WHEN #SELECT(2) NE ' ' 
0032    MOVE 'S' TO MAR-STAT
0033    MOVE 'SINGLE' TO #MAR-DESCR
0034    
0035  WHEN #SELECT(3) NE ' '
0036    MOVE 'D' TO MAR-STAT
0037    MOVE ' DIVORCED' TO #MAR-DESCR
0038    
0039  WHEN #SELECT(4) NE ' '
0040    MOVE 'M' TO MAR-STAT
0041    MOVE 'MARRIED' TO #MAR-DESCR
0042    
0043  WHEN  NONE
0044    REINPUT ' Please select one option with "X"'
0045
0046END-DECIDE
0047
0048
0049END
