0005DEFINE DATA LOCAL 
00061 ALPHA (A20)
00071 DYN (A) DYNAMIC
0008END-DEFINE
0009
0010MOVE '1234567590' TO ALPHA
0011COMPRESS ALPHA TO DYN /* DYNAMIC FIELDS ARE FLEXIBLE WITH LENGTH
0012/* USE COMPRESS TO REMOVE LEADING ZEROS AND TRAILING BLANKS IF THE VALUE IS LESS THAN LENGTH.
0013WRITE 'LENGTH FOR DYNAMIC:' *LENGTH(DYN)
0014
0015
0016REDUCE DYNAMIC DYN TO 6
0017WRITE 'REDUCED DYNAMIC LENGTH:' *LENGTH(DYN)
0018 
0019RESET DYN
0020WRITE 'DYN RESET LENTH' *LENGTH(DYN)
0021
0022MOVE ALL 'A' TO DYN UNTIL 13
0023WRITE / 'DYN AFTER MOVE ALL' *LENGTH(DYN)
0024
0025MOVE ALL ' ' TO ALPHA UNTIL 30 
0026COMPRESS ALPHA TO DYN
0027WRITE 'LENGTH AFTER COMPRESSED' *LENGTH(DYN)
0028
0029
0030END
