0004/* TODO Enter your code here
0005DEFINE DATA 
0006PARAMETER
00071 #COUNTRY (A20)
0008
0009LOCAL
00101 #SELECT (A1/1:7)
00111 #INDEX (N1)
0012
0013END-DEFINE
0014
0015INPUT USING MAP "CNT1"
0016
0017IF *PF-KEY = 'PF3'
0018  ESCAPE MODULE
0019END-IF
0020
0021IF #SELECT(*) = 'X'
0022DECIDE FOR FIRST CONDITION
0023  WHEN #SELECT(1) NE ' '
0024    MOVE 'SOUTH AFRICA' TO #COUNTRY
0025    
0026  WHEN #SELECT(2) NE ' '
0027    MOVE 'ZIMBABWE' TO #COUNTRY
0028
0029WHEN #SELECT(3) NE ' '
0030    MOVE 'BOTSWANA' TO #COUNTRY
0031    
0032    WHEN #SELECT(4) NE ' '
0033    MOVE 'NAMIBIA' TO #COUNTRY
0034    
0035    WHEN #SELECT(5) NE ' '
0036    MOVE 'ESWATINI' TO #COUNTRY
0037    
0038    WHEN #SELECT(6) NE ' '
0039    MOVE 'LESOTHO' TO #COUNTRY
0040    
0041    WHEN #SELECT(7) NE ' '
0042    MOVE 'MOZAMBIQUE' TO #COUNTRY
0043    
0044  WHEN  NONE
0045    REINPUT ' Please select one option with "X"'
0046    END-DECIDE
0047    
0048    ELSE
0049    REINPUT ' Please select one option with "X"'
0050    END-IF
0051END
