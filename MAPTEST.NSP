0005DEFINE DATA LOCAL
00061 #PROGRAM (A8)
00071 #PERSON-ID (N8)
00081 REDEFINE #PERSON-ID
0009  2 #N-ID(N8)
00101 #FIRST-NAME (A20)
00111 #SURNAME (A20)
00121 REDEFINE #SURNAME
0013  2 #ZIP (A3)
0014  2 #REST (A17)
00151 #CITY (A20)
00161 #COUNTRY (A20)
00171 #DEPARTMENT (A10)
00181 #LANGUAGE (A4/1:3)
00191 #CV (C)
0020
0021END-DEFINE
0022*
0023SET CONTROL 'MT'
0024SET KEY 
0025  PF2 = HELP
0026  PF3 NAMED 'EXIT'
0027
0028*
0029MOVE *PROGRAM TO #PROGRAM
0030*
0031MOVE (AD=I) TO #CV
0032*
0033INPUT USING MAP "MAP1"
0034*
0035 IF *PF-KEY = 'PF3'
0036   ESCAPE MODULE
0037 END-IF
0038
0039
0040**************************************
0041IF #ZIP NE 'ZIP'
0042  REINPUT FULL 'SURNAME MUST START WITH ''ZIP'''
0043    MARK *#SURNAME
0044END-IF 
0045
0046IF #REST = ' '
0047  REINPUT FULL 'SURNAME CANNOT BE BLANK'
0048    MARK *#SURNAME
0049END-IF
0050
0051IF #FIRST-NAME NE SCAN '*'
0052  REINPUT FULL 'FIRST NAME MUST HAVE ''*'''
0053    MARK *#FIRST-NAME
0054END-IF
0055
0056IF #COUNTRY = ' '
0057  REINPUT FULL 'COUNTRY CANNOT BE BLANK'
0058    MARK *#COUNTRY
0059END-IF
0060
0061IF #LANGUAGE(1) = ' '
0062  REINPUT FULL 'LANGUAGE CANNOT BE BLANK'
0063    MARK *#LANGUAGE(1)
0064END-IF
0065
0066MOVE (AD=P) TO #CV
0067INPUT USING MAP "MAP1"
0068
0069END
