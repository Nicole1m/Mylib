0001/** New Program WRK7FIND.
0002/**
0003/** :author msh
0004/* TODO Enter your code here
0005DEFINE DATA LOCAL
0006
00071 EMPLOYEES VIEW OF EMPLOYEES
0008  2 PERSONNEL-ID (A8)
0009  2 NAME (A20)
0010  2 GENDER (A1)
0011  2 DEPT (A6)
00121 DEPARTMENT (A20) CONST <'SALE'>
0013END-DEFINE
0014*
0015FORMAT LS=150 
0016* FORMAT PS=50
0017*
0018F1.  FIND EMPLOYEES WITH 
0019    EMPLOYEES.DEPARTMENT EQ DEPARTMENT
0020    WHERE EMPLOYEES.GENDER EQ 'F'
0021
0022  IF NO RECORD FOUND
0023    WRITE ' NO RECORD FOUND'
0024    ESCAPE BOTTOM (F1.)
0025  END-NOREC
0026* 
0027  DISPLAY *ISN
0028    'Number' *NUMBER
0029    'COUNTER' *COUNTER
0030    EMPLOYEES.PERSONNEL-ID
0031    EMPLOYEES.NAME (AL=10)
0032    EMPLOYEES.GENDER
0033    EMPLOYEES.DEPT
0034
0035  AT END OF DATA
0036    WRITE 'NUMBER OF RECORDS SHOW:'
0037      COUNT(F1.) (EMPLOYEES.PERSONNEL-ID)
0038  END-ENDDATA
0039END-FIND
0040
0041END
