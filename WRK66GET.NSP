0001/** New Program WRK66GET.
0002/**
0003/** :author msh
0004/* TODO Enter your code here
0005DEFINE DATA LOCAL 
00061 EMPLOYEES VIEW OF EMPLOYEES
0007  2 PERSONNEL-ID (A8) 
0008  2 FIRST-NAME (A20)
0009  2 NAME (A20)
0010
0011
0012*******  MAP FIELDS
00131 #SELECT (A1/1:16)
00141 #PERSONNEL-ID (A8/1:16)
00151 #FIRST-NAME (A20/1:16)
00161 #NAME (A20/1:16)
0017
00181 #I (N3)
00191 #SEL-INDEX (N3)
00201 RESTART-VALUE (A20)
00211 #START-VALUE (A20)
00221 #SEARCH-NAME (A20)
0023
00241 #CV-SELECT (C/1:16)
00251 #REPOS-FLAG (A1)
00261 #ISN (N8/1:16)
0027END-DEFINE
0028
0029SET CONTROL 'MT'
0030SET KEY 
0031  PF1 = HELP
0032  PF3 NAMED 'EXIT'
0033  PF8 NAMED 'NEXT'
0034
0035READ EMPLOYEES WITH REPOSITION
0036    BY NAME
0037    STARTING FROM #START-VALUE
0038
0039
0040  ADD 1 TO #I
0041
0042  #PERSONNEL-ID(#I) := PERSONNEL-ID 
0043  #FIRST-NAME(#I)   := FIRST-NAME
0044  #NAME(#I)         := NAME
0045  
0046    MOVE *ISN TO #ISN(#I)
0047    
0048  IF #I = 16
0049    REPEAT
0050
0051      INPUT USING MAP "WRK66-1"
0052
0053
0054      DECIDE ON FIRST VALUE OF *PF-KEY
0055        VALUE 'PF3'
0056          ESCAPE MODULE
0057        VALUE 'PF8'
0058          ESCAPE BOTTOM
0059        VALUE 'ENTR'
0060          IGNORE
0061        NONE
0062          REINPUT WITH TEXT 'Use a valid function keys'
0063      END-DECIDE
0064
0065
0066      FOR #SEL-INDEX = 1 TO 16
0067        IF #SELECT(#SEL-INDEX) = 'X'
0068          CALLNAT 'WRK66-S' #PERSONNEL-ID(#SEL-INDEX) #ISN(#SEL-INDEX)
0069          RESET #SELECT(#SEL-INDEX)
0070        END-IF
0071
0072      END-FOR
0073
0074      IF RESTART-VALUE NE ' '
0075        MOVE RESTART-VALUE TO #START-VALUE #SEARCH-NAME
0076        RESET RESTART-VALUE
0077        RESET #I
0078        MOVE 'Y' TO #REPOS-FLAG
0079        ESCAPE BOTTOM
0080      END-IF
0081
0082    END-REPEAT
0083
0084    RESET #I
0085    IF #REPOS-FLAG = 'Y'
0086      RESET #REPOS-FLAG
0087      ESCAPE TOP REPOSITION
0088    END-IF
0089
0090
0091  END-IF
0092END-READ 
0093
0094IF #I < 16
0095
0096  RESET
0097    #PERSONNEL-ID(#I + 1:16 )
0098    #NAME(#I + 1:16)
0099    #FIRST-NAME(#I + 1:16) 
0100  MOVE (AD=P) TO #CV-SELECT(#I + 1:16)
0101  INPUT USING MAP "WRK66-1"
0102END-IF
0103END
