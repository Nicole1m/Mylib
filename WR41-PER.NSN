0001/** New Subprogram WR41-PER.
0002/**
0003/** :author msh
0004/* TODO Enter your code here
0005DEFINE DATA
0006PARAMETER
00071 #PERSONNEL-ID (A8)
0008
0009LOCAL
00101 EMPLOYEES VIEW OF EMPLOYEES
0011  2 PERSONNEL-ID (A8) 
0012  2 FIRST-NAME (A20)
0013  2 NAME (A20)
0014  2 MIDDLE-I (A20)
0015  2 MAR-STAT (A1)
0016  2 GENDER (A1)
0017  2 LANG (A3/1:5)
0018
00191 #GENDER-DESCR (A10)
00201 #MAR-DESCR (A10)
0021
00221 #CV-FIRST-NAME (C)
00231 #CV-NAME (C)
00241 #CV-MIDDLE-NAME(C)
00251 #CV-MARITAL-STATUS (C)
00261 #CV-GENDER (C)
00271 #CV-LANG (C/1:5)
00281 #CV-G-DESCR (C)
00291 #CV-MAR-DESCR (C)
0030END-DEFINE
0031
0032SET KEY 
0033  PF4 NAMED 'UPDATE'
0034
0035
0036MOVE (AD=P) TO #CV-FIRST-NAME
0037MOVE (AD=P) TO #CV-NAME
0038MOVE (AD=P) TO #CV-MIDDLE-NAME
0039MOVE (AD=P) TO #CV-GENDER
0040MOVE (AD=P) TO #CV-MARITAL-STATUS
0041MOVE (AD=P) TO #CV-LANG(1:5)
0042
0043
0044FIND EMPLOYEES WITH PERSONNEL-ID EQ #PERSONNEL-ID
0045
0046
0047  DECIDE ON FIRST VALUE OF GENDER
0048    VALUE 'F' MOVE 'FEMALE' TO #GENDER-DESCR
0049    VALUE 'M' MOVE 'MALE' TO #GENDER-DESCR
0050    NONE
0051      MOVE 'INVALID' TO #GENDER-DESCR
0052  END-DECIDE
0053
0054  DECIDE ON FIRST VALUE OF MAR-STAT
0055    VALUE 'M' MOVE 'MARRIED' TO #MAR-DESCR
0056    VALUE 'D' MOVE 'DIVORCED' TO #MAR-DESCR
0057    VALUE 'S' MOVE 'SINGLE' TO #MAR-DESCR
0058    VALUE 'W' MOVE 'WIDOWED' TO #MAR-DESCR
0059    NONE
0060      MOVE 'INVALID' TO #MAR-DESCR
0061  END-DECIDE
0062
0063  INPUT USING MAP "WR41-PM"
0064
0065  IF *PF-KEY = 'PF4'
0066    MOVE (AD=I) TO #CV-FIRST-NAME
0067    MOVE (AD=I) TO #CV-NAME
0068    MOVE (AD=I) TO #CV-MIDDLE-NAME
0069    MOVE (AD=I) TO #CV-GENDER
0070    MOVE (AD=I) TO #CV-MARITAL-STATUS
0071    MOVE (AD=I) TO #CV-LANG(*)
0072    INPUT USING MAP "WR41-PM"
0073    END-IF
0074    
0075     IF NAME = ' '
0076    REINPUT 'NAME IS REQUIRED'
0077      MARK *NAME
0078  END-IF 
0079
0080  IF FIRST-NAME = ' '
0081    REINPUT 'FIRST-NAME IS REQUIRED'
0082      MARK *FIRST-NAME
0083  END-IF 
0084
0085  IF GENDER  = ' '
0086    REINPUT 'GENDER IS REQUIRED'
0087      MARK *GENDER
0088  END-IF 
0089  
0090  IF MAR-STAT  = ' '
0091    REINPUT 'MARITAL STATUS IS REQUIRED'
0092      MARK *MAR-STAT
0093  END-IF 
0094
0095  IF LANG(1)  = ' '
0096    REINPUT 'LANGUAGE IS REQUIRED'
0097      MARK *LANG(1)
0098  END-IF
0099
0100    IF GENDER NE 'F' AND
0101        GENDER NE 'M'
0102      REINPUT 'Invalid Gender'
0103        MARK *GENDER
0104    END-IF
0105
0106    IF MAR-STAT NE 'M' AND
0107        MAR-STAT NE 'W' AND
0108        MAR-STAT NE 'D' AND
0109        MAR-STAT NE 'S'
0110      REINPUT 'Invalid Marital Status'
0111        MARK *MAR-STAT
0112      ESCAPE BOTTOM
0113    END-IF
0114    
0115    UPDATE 
0116 MOVE (AD=P) TO #CV-FIRST-NAME
0117MOVE (AD=P) TO #CV-NAME
0118MOVE (AD=P) TO #CV-MIDDLE-NAME
0119MOVE (AD=P) TO #CV-GENDER
0120MOVE (AD=P) TO #CV-MARITAL-STATUS
0121MOVE (AD=P) TO #CV-LANG(1:5)
0122
0123    INPUT WITH TEXT 'RECORD HAS BEEN UPDATED'
0124    
0125   USING MAP "WR41-PM"
0126
0127
0128END-FIND
0129END
0130
