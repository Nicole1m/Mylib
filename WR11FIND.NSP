0005DEFINE DATA LOCAL 
0006
00071 EMPLOYEES VIEW OF EMPLOYEES
0008  2 PERSONNEL-ID (A8) 
0009  2 NAME (A20)
0010  2 CITY (A20)
0011  2 DEPT (A6)
0012  2 DEPARTMENT (A4)
0013/*1 INCOME (1:3)
0014  2 CURR-CODE (1:3)
0015  2 SALARY (P9/1:3)
0016  2 BONUS (1:3, 1:3)/*(P9/1:3)
0017
00181 #YEAR (I1)
0019
0020END-DEFINE
0021
0022FIND EMPLOYEES WITH DEPARTMENT = 'SALE'
0023
0024  WRITE
0025   'ID:' PERSONNEL-ID
0026   'NAME:' NAME
0027   'DEPT:' DEPT
0028   'CITY:' CITY
0029
0030  FOR #YEAR = 1 TO 3 
0031    WRITE 'YEAR:' #YEAR
0032      CURR-CODE (#YEAR)
0033      SALARY (#YEAR)
0034      BONUS (#YEAR, 1:3)
0035      
0036     
0037  END-FOR 
0038END-FIND
0039END
