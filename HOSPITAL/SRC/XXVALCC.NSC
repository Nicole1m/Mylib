0010* A LOVELY PIECE OF COPYCODE WITH EXTRA DATE VALIDATION FOR
0020* THE ARRIVAL DATE!
0030*
0040*
0050DEFINE SUBROUTINE VALIDATE-ARRIVED
0060*
0070MOVE #V-VAL(1) TO #W-DD1
0080MOVE #V-VAL(2) TO #W-DD2
0090*
0100IF #W-DD < "01" OR #W-DD > "31" OR #W-DD NOT = MASK(NN)
0110   MOVE "INVALID DAY NUMBER SPOTTED - FORMAT IS DD-MONTH-YY!"
0120       TO #W-MESSAGE
0130   MOVE 8 TO #W-MARK
0140   PERFORM SET-MESSAGE
0150   ESCAPE ROUTINE
0160END-IF
0170*
0180IF #V-VAL(3) NOT = "-"
0190   MOVE "POSITION 3 MUST BE A '-' - FORMAT IS DD-MONTH-YY!"
0200       TO #W-MESSAGE
0210   MOVE 8 TO #W-MARK
0220   PERFORM SET-MESSAGE
0230   ESCAPE ROUTINE
0240END-IF
0250***
0260RESET #W-MM
0270FOR #W-LOOP = 4 TO 15
0280  IF #V-VAL(#W-LOOP) = "-"
0290     ESCAPE BOTTOM
0300  END-IF
0310  IF #W-LOOP > 4
0320     EXAMINE #V-VAL(#W-LOOP) AND TRANSLATE INTO LOWER
0330  ELSE
0340     EXAMINE #V-VAL(#W-LOOP) AND TRANSLATE INTO UPPER
0350  END-IF
0360  MOVE #V-VAL(#W-LOOP) TO #W-MM-PART(#W-LOOP - 3)
0370END-FOR
0380*
0390* SAVE THE CURRENT INDEX VALUE FOR LATER CHECKING!
0400*
0410MOVE #W-LOOP TO #W-SAVE-LOOP
0420
0430*
0440MOVE FALSE TO #W-FOUND
0450FOR #W-LOOP = 1 TO 12
0460  IF #W-MM = #L-MONTHS(#W-LOOP)
0470     MOVE TRUE TO #W-FOUND
0480     ESCAPE BOTTOM
0490  END-IF
0500END-FOR
0510*
0520IF NOT #W-FOUND
0530   MOVE "INVALID MONTH DETECTED - FORMAT IS DD-MONTH-YY!"
0540      TO #W-MESSAGE
0550   MOVE 8 TO #W-MARK
0560   PERFORM SET-MESSAGE
0570   ESCAPE ROUTINE
0580END-IF
0590*
0600IF #W-DD-N > #L-DAYS(#W-LOOP) AND #W-LOOP NE 2
0610   MOVE "INVALID NUMBER OF DAYS DETECTED FOR THE MONTH" TO
0620       #W-MESSAGE
0630   MOVE 8 TO #W-MARK
0640   PERFORM SET-MESSAGE
0650   ESCAPE ROUTINE
0660END-IF
0670*
0680IF #V-VAL(#W-SAVE-LOOP) NOT = "-"
0690   MOVE "POSITION AFTER MONTH MUST BE A '-' - FORMAT IS DD-MONTH-YY!"
0700       TO #W-MESSAGE
0710   MOVE 8 TO #W-MARK
0720   PERFORM SET-MESSAGE
0730   ESCAPE ROUTINE
0740END-IF
0750*
0760MOVE #V-VAL(#W-SAVE-LOOP + 1) TO #W-YY1
0770MOVE #V-VAL(#W-SAVE-LOOP + 2) TO #W-YY2
0780IF #W-YY < "30" OR #W-YY > "99"
0790   MOVE "INVALID YEAR ENTERED - MUST BE GREATER THAN 30"
0800       TO #W-MESSAGE
0810   MOVE 8 TO #W-MARK
0820   PERFORM SET-MESSAGE
0830   ESCAPE ROUTINE
0840END-IF
0850*
0860IF #W-MM = #L-MONTHS(2)  /* THEN IT IS FEBURARY, CHECK LEAP YEAR!
0870   DIVIDE 4 INTO #W-YY-N REMAINDER #W-LOOP
0880   IF #W-LOOP = 0 /* CRUDE, BUT MUST BE A LEAP YEAR..FORGETTING 1900/
0890                  /* 2000 ARGUMENTS AS THIS IS A NON YR2000 PROGGIE!
0900      IF #W-DD-N > 29
0910         MOVE "INVALID NUMBER OF DAYS DETECTED - FEB IN A LEAP YEAR"
0920            TO #W-MESSAGE
0930         MOVE 8 TO #W-MARK
0940         PERFORM SET-MESSAGE
0950         ESCAPE ROUTINE
0960      END-IF
0970   ELSE
0980      IF #W-DD-N > 28
0990         MOVE "INVALID NUMBER OF DAYS DETECTED  -FEB NOT IN A LEAP YEAR"
1000           TO #W-MESSAGE
1010         MOVE 8 TO #W-MARK
1020         PERFORM SET-MESSAGE
1030         ESCAPE ROUTINE
1040      END-IF
1050   END-IF
1060END-IF
1070*
1080END-SUBROUTINE
