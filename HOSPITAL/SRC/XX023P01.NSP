0010* THIS PROGRAM LISTS THE PATIENTS BY PATIENT-ID
0020*
0030DEFINE DATA GLOBAL USING XX000G00
0040LOCAL USING XX021L01
0050LOCAL
006001 #W-LOOP(P3)
007001 #W-PAGE-NUMBER(P3)
008001 #M-SELECTED(A1/1:15)
009001 #C-SELECTED(C)
010001 #M-YEAR(N2)
011001 REDEFINE #M-YEAR
0120  02 #M-YEAR-ALPHA(A2)
0130*
014001 #W-PAGE-KEY(N7/1:100)
015001 #W-START-KEY(N7)
016001 #M-NAME(A40/1:15)
017001 #M-PATIENT-ID(N7/1:15)
018001 #W-END-OF-DATA(L)
0190END-DEFINE
0200*
0210SET KEY ALL
0220*
0230MOVE 1 TO #W-PAGE-NUMBER
0240*
0250* SET UP THE FIRST READ KEY!
0260*
0270INPUT #M-YEAR
0280MOVE #M-YEAR TO #W-PAGE-KEY(1)
0290MULTIPLY #W-PAGE-KEY(1) BY 100000 GIVING #W-PAGE-KEY(1)
0300PERFORM READ-DATA
0310*
0320REPEAT
0330*
0340  INPUT USING MAP "XX023M01"
0350  RESET #G-MESSAGE
0360*
0370  DECIDE ON FIRST VALUE OF *PF-KEY
0380*
0390    VALUE "PF12", "PF24"
0400      PERFORM XXEXIT
0410    VALUE "PF3", "PF15"
0420      ESCAPE ROUTINE
0430    VALUE "PF8", "PF20"
0440      IF #W-END-OF-DATA
0450        MOVE "NO MORE DATA AVAILABLE" TO #G-MESSAGE
0460        ESCAPE TOP
0470      END-IF
0480      IF #W-PAGE-NUMBER = 100
0490        MOVE "SORRY, ONLY 100 PAGES AVAILABLE" TO #G-MESSAGE
0500        ESCAPE TOP
0510      END-IF
0520      ADD 1 TO #W-PAGE-NUMBER
0530      PERFORM READ-DATA
0540      ESCAPE TOP
0550    VALUE "PF7", "PF19"
0560      IF #W-PAGE-NUMBER = 1
0570        MOVE "CANNOT PAGE BACK FROM FIRST PAGE" TO #G-MESSAGE
0580        ESCAPE TOP
0590      END-IF
0600      SUBTRACT 1 FROM #W-PAGE-NUMBER
0610      PERFORM READ-DATA
0620      MOVE FALSE TO #W-END-OF-DATA
0630      ESCAPE TOP
0640    VALUE "ENTR"
0650      IGNORE
0660    NONE VALUE
0670      MOVE "INVALID PF KEY PRESSED" TO #G-MESSAGE
0680  END-DECIDE
0690*
0700END-REPEAT
0710*
0720DEFINE SUBROUTINE READ-DATA
0730*
0740RESET #W-LOOP
0750MOVE #W-PAGE-KEY(#W-PAGE-NUMBER) TO #W-START-KEY
0760READ PATIENT BY PATIENT-ID STARTING FROM #W-START-KEY
0770  IF #V-NUMBER = 99999
0780    ESCAPE TOP
0790  END-IF
0800*
0810  IF #V-YY NOT = #M-YEAR-ALPHA
0820    ESCAPE BOTTOM
0830  END-IF
0840*
0850  ADD 1 TO #W-LOOP
0860*
0870  IF #W-LOOP = 16
0880    MOVE PATIENT-ID TO #W-PAGE-KEY(#W-PAGE-NUMBER + 1)
0890    ESCAPE ROUTINE
0900  END-IF
0910*
0920  MOVE PATIENT-ID TO #M-PATIENT-ID(#W-LOOP)
0930  COMPRESS FIRST-NAME SURNAME INTO #M-NAME(#W-LOOP)
0940*
0950END-READ
0960*
0970MOVE TRUE TO #W-END-OF-DATA
0980*
0990END-SUBROUTINE
1000*
1010END
