0010* THIS PROGRAM LISTS THE PATIENTS BY NAME
0020*
0030DEFINE DATA GLOBAL USING XX000G00
0040LOCAL USING XX021L01
0050LOCAL
006001 #W-LOOP(P3)
007001 #W-PAGE-NUMBER(P3)
008001 #M-SELECTED(A1/1:15)
009001 #C-SELECTED(C)
010001 #M-YEAR(N2)
0110****
012001 #W-PAGE-KEY(A27/1:100)
013001 #W-START-KEY(A27)
014001 #M-NAME(A40/1:15)
015001 #M-PATIENT-ID(N7/1:15)
016001 #W-END-OF-DATA(L)
017001 #W-TEMP-KEY(A27)
018001 REDEFINE #W-TEMP-KEY
0190  02 #W-TEMP-SURNAME(A20)
0200  02 #W-TEMP-PATIENT-ID(N7)
0210*
0220END-DEFINE
0230*
0240SET KEY ALL
0250*
0260MOVE 1 TO #W-PAGE-NUMBER
0270*
0280* SET UP THE FIRST READ KEY!
0290*
0300PERFORM READ-DATA
0310*
0320REPEAT
0330*
0340  INPUT USING MAP "XX025M01"
0350  RESET #G-MESSAGE
0360*
0370  DECIDE ON FIRST VALUE OF *PF-KEY
0380*
0390    VALUE "PF12", "PF24"
0400      PERFORM XXEXIT
0410    VALUE "PF3", "PF15"
0420      ESCAPE ROUTINE
0430    VALUE "PF8", "PF20"
0440      IF #W-END-OF-DATA
0450        MOVE "NO MORE DATA AVAIALBLE" TO #G-MESSAGE
0460        ESCAPE TOP
0470      END-IF
0480      IF #W-PAGE-NUMBER = 100
0490        MOVE "SORRY, ONLY 100 PAGES AVAILABLE" TO #G-MESSAGE
0500        ESCAPE TOP
0510      END-IF
0520      ADD 1 TO #W-PAGE-NUMBER
0530      PERFORM READ-DATA
0540      ESCAPE TOP
0550    VALUE "PF7", "PF19"
0560      SUBTRACT 1 FROM #W-PAGE-NUMBER
0570      PERFORM READ-DATA
0580      MOVE FALSE TO #W-END-OF-DATA
0590      ESCAPE TOP
0600    VALUE "ENTR"
0610      PERFORM PROCESS-SELECTED
0620    NONE VALUE
0630      MOVE "INVALID PF KEY PRESSED" TO #G-MESSAGE
0640  END-DECIDE
0650*
0660END-REPEAT
0670*
0680DEFINE SUBROUTINE READ-DATA
0690*
0700RESET #M-PATIENT-ID(*) #M-NAME(*) #M-SELECTED(*)
0710RESET #W-LOOP
0720MOVE #W-PAGE-KEY(#W-PAGE-NUMBER) TO #W-START-KEY
0730READ PATIENT BY S2-SURNAME-PATIENT-ID
0740*
0750  IF #V-NUMBER = 99999
0760    ESCAPE TOP
0770  END-IF
0780  ADD 1 TO #W-LOOP
0790*
0800  IF #W-LOOP = 16
0810    MOVE PATIENT-ID TO #W-TEMP-PATIENT-ID
0820    MOVE SURNAME TO #W-TEMP-SURNAME
0830    MOVE #W-TEMP-KEY TO #W-PAGE-KEY(#W-PAGE-NUMBER + 1)
0840    ESCAPE ROUTINE
0850  END-IF
0860*
0870  MOVE PATIENT-ID TO #M-PATIENT-ID(#W-LOOP)
0880  COMPRESS FIRST-NAME SURNAME INTO #M-NAME(#W-LOOP)
0890*
0900END-READ
0910*
0920MOVE TRUE TO #W-END-OF-DATA
0930*
0940END-SUBROUTINE
0950*
0960DEFINE SUBROUTINE PROCESS-SELECTED
0970*
0980FOR #W-LOOP = 1 TO 15
0990  DECIDE FOR FIRST CONDITION
1000    WHEN #M-SELECTED(#W-LOOP) = " "
1010      ESCAPE TOP
1020    WHEN #M-SELECTED(#W-LOOP) NOT = " "  AND
1030        #M-PATIENT-ID(#W-LOOP) = 0
1040      MOVE "YOU SELECTED A BLANK LINE - TRY AGAIN!" TO #G-MESSAGE
1050      ESCAPE ROUTINE
1060    WHEN #M-SELECTED(#W-LOOP) = "D" OR = "M"
1070      MOVE #M-SELECTED(#W-LOOP) TO #G-SELECTED-OPTION
1080      FETCH RETURN "XX021P01" #M-PATIENT-ID(#W-LOOP)
1090      MOVE " " TO #M-SELECTED(#W-LOOP)
1100    WHEN NONE
1110      MOVE "INVALID CHARACTER FOUND IN SELECTION ARRAY" TO #G-MESSAGE
1120      ESCAPE ROUTINE
1130  END-DECIDE
1140END-FOR
1150PERFORM READ-DATA
1160END-SUBROUTINE
1170END
