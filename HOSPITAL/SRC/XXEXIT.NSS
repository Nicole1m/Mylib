0010DEFINE DATA LOCAL
0020*
003001 #A(A1)
0040*
0050END-DEFINE
0060*
0070DEFINE SUBROUTINE XXEXIT
0080*
0090SET CONTROL "WL60C10B10/10F"
0100*
0110INPUT / "Do you really wish to exit the Hospital System?"
0120  // "PF12/24 to Exit, any other PF Key to return"
0130*
0140SET CONTROL "WB"
0150*
0160IF *PF-KEY = "PF12" OR = "PF24"
0170  STOP
0180END-IF
0190*
0200**
0210**
0220END-SUBROUTINE
0230END
