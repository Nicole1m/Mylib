0010DEFINE DATA GLOBAL USING XX000G00
0020LOCAL USING XX001L01
0030*
0040LOCAL
00501 #I (A10)
0060*
0070END-DEFINE
0080*
0090SET KEY ALL
0100*
0110REPEAT
0120**
0130***
0140  INPUT USING MAP "XX001M01"
0150  RESET #L-MESSAGE
0160*
0170  WRITE 'Hello'
0180  DECIDE ON FIRST VALUE OF *PF-KEY
0190*
0200    VALUE "PF12", "PF24"
0210      PERFORM XXEXIT
0220    VALUE 'ENTR'
0230      IF #M-OPTION = "P"
0240        FETCH "XX002P01"
0250      END-IF
0260      IF #M-OPTION = "S"
0270        FETCH "XX003P01"
0280      END-IF
0290      MOVE "INVALID OPTION SELECTED" TO #L-MESSAGE
0300    NONE VALUE
0310      MOVE "INVALID PF KEY PRESSED" TO #L-MESSAGE
0320  END-DECIDE
0330*
0340END-REPEAT
0350END
