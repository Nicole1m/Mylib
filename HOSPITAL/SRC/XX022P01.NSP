0010DEFINE DATA GLOBAL USING XX000G00
0020LOCAL USING XX021L01
0030LOCAL
004001 #C-GROUP(C/1:10)
005001 REDEFINE #C-GROUP
0060  2 #C-PATIENT-ID(C)
0070  2 #C-FIRST-NAME(C)
0080  2 #C-SURNAME(C)
0090  2 #C-DOB(C)
0100  2 #C-RELEASED(C)
0110  2 #C-ADDRESS(C)
0120  02 #C-ARRIVED(C)
0130  02 #C-DUE-FOR-SURGERY(C)
0140*
015001 #P-PATIENT-ID(N7)
0160*
0170END-DEFINE
0180*
0190INPUT #P-PATIENT-ID
0200FIND PATIENT WITH PATIENT-ID = #P-PATIENT-ID
0210*
0220  IF NO RECORDS FOUND
0230    MOVE "INVALID PATIENT ID PASSED TO AMEND PROGRAM" TO #G-MESSAGE
0240    ESCAPE ROUTINE
0250  END-NOREC
0260*
0270END-FIND
0280*
0290SET KEY ALL
0300*
0310REPEAT
0320*
0330  INPUT USING MAP "XX022M01"
0340  RESET #G-MESSAGE
0350*
0360  DECIDE ON FIRST VALUE OF *PF-KEY
0370*
0380    VALUE "PF12","PF24"
0390      PERFORM XXEXIT
0400    VALUE "ENTR"
0410      IGNORE
0420    NONE VALUE
0430      MOVE "INVALID PF KEY PRESSED" TO #G-MESSAGE
0440  END-DECIDE
0450*
0460END-REPEAT
0470*
0480END
