0010* THIS IS THE MAIN VALIDATION PROGRAM USED FOR INSERTS/DELETES/MODIFIES!
0020*
0030DEFINE DATA GLOBAL USING XX000G00
0040LOCAL USING XX021L01
0050LOCAL USING XX021L02
0060LOCAL USING XXMTHVAL
0070LOCAL
008001 #C-GROUP(C/1:10)
009001 REDEFINE #C-GROUP
0100  02 #C-PATIENT-ID(C)
0110  02 #C-FIRST-NAME(C)
0120  02 #C-SURNAME(C)
0130  02 #C-DOB(C)
0140  02 #C-RELEASED(C)
0150  02 #C-ADDRESS(C)
0160  02 #C-ARRIVED(C)
0170  02 #C-DUE-FOR-SURGERY(C)
018001 #P-PATIENT-ID(N7)
0190*
020001 #W-OK(L)
021001 #W-DD(A2)
022001 REDEFINE #W-DD
0230  02 #W-DD1(A1)
0240  02 #W-DD2(A1)
025001 REDEFINE #W-DD
0260  02 #W-DD-N(N2)
027001 #W-MM(A12)
028001 REDEFINE #W-MM
0290  02 #W-MM-PART(A1/1:12)
0300*
031001 #W-LOOP(P3)
032001 #W-SAVE-LOOP(P3)
033001 #W-FOUND(L)
0340*
035001 #W-MESSAGE(A70)
0360*
037001 #W-MARK(P3)
0380*
039001 #L-TEMP-RELEASED(A6)
040001 REDEFINE #L-TEMP-RELEASED
0410  02 #L-TEMP-RELEASED-NUMERIC(N6)
0420*
043001 #W-CONFIRM-UPDATE(A1)
0440*
045001 #L-TEMP-DATE(N8)
046001 REDEFINE #L-TEMP-DATE
0470  02 FILLER 2X
0480  02 #L-TEMP-DATE-N6(N6)
0490*
050001 #W-MAP-MARK(P3)
0510*
052001 #W-YY(A2)
053001 REDEFINE #W-YY
0540  02 #W-YY1(A1)
0550  02 #W-YY2(A1)
056001 REDEFINE #W-YY
0570  02 #W-YY-N(N2)
058001 #W-DATE-D(D)
0590*
060001 #M-MAP-HEADING(A40)
061001 #M-UNDERLINE(A40)
0620END-DEFINE
0630*
0640SET KEY ALL
0650MOVE *DATN TO #L-TEMP-DATE
0660DECIDE ON FIRST VALUE OF #G-SELECTED-OPTION
0670  VALUE "A"
0680    MOVE *DATX TO PATIENT.RELEASED
0690    CALLNAT "XXGETID" PATIENT.PATIENT-ID #L-TEMP-DATE-N6
0700    MOVE "              ADD A PATIENT" TO #M-MAP-HEADING
0710    MOVE "              *************" TO #M-UNDERLINE
0720    MOVE (AD=D) TO #C-GROUP(*)
0730    MOVE (AD=P) TO #C-PATIENT-ID
0740  VALUE "D"
0750    PERFORM GET-RECORD
0760    MOVE (AD=P) TO #C-GROUP(*)
0770    MOVE "            DELETE A PATIENT" TO #M-MAP-HEADING
0780    MOVE "            ****************" TO #M-UNDERLINE
0790  VALUE "M"
0800    PERFORM GET-RECORD
0810    MOVE "            MODIFY A PATIENT" TO #M-MAP-HEADING
0820    MOVE "            ****************" TO #M-UNDERLINE
0830    MOVE (AD=D) TO #C-GROUP(*)
0840    MOVE (AD=P) TO #C-PATIENT-ID
0850  NONE VALUE
0860    WRITE "INVALID VALUE FOUND IN #G-SELECTED-OPTION!"
0870    STOP
0880END-DECIDE
0890*
0900REPEAT
0910*
0920  INPUT MARK #W-MAP-MARK USING MAP "XX021M01"
0930*
0940  MOVE (AD=D) TO #C-GROUP(*)
0950  MOVE (AD=P) TO #C-PATIENT-ID
0960  RESET #G-MESSAGE
0970*
0980* NEED TO CONVERT THE D FORMAT DATE INTO A SUITABLE NUMBER TO COMPARE
0990* AGAINST THE SURGERY DATE!
1000*
1010  MOVE EDITED PATIENT.RELEASED(EM=YYMMDD) TO #L-TEMP-RELEASED
1020*
1030  DECIDE ON FIRST VALUE OF *PF-KEY
1040    VALUE "PF12", "PF24"
1050      PERFORM XXEXIT
1060    VALUE "PF3", "PF15"
1070      IF #G-SELECTED-OPTION NOT = "A"
1080        ESCAPE ROUTINE
1090      ELSE
1100        FETCH "XX002P01"
1110      END-IF
1120    VALUE "ENTR"
1130      IF #G-SELECTED-OPTION NOT = "D"
1140        PERFORM VALIDATION
1150        IF #W-CONFIRM-UPDATE = "Y"
1160          ESCAPE ROUTINE
1170        END-IF
1180      ELSE
1190        SET CONTROL "WL70C5B5/5F"
1200        MOVE "N" TO #W-CONFIRM-UPDATE
1210        INPUT / "DO YOU REALLY WANT TO DELETE THIS PATIENT? - (Y/N)" #W-CONFIRM-UPDATE(AD=IMT)
1220        SET CONTROL "WB"
1230        IF #W-CONFIRM-UPDATE = "Y"
1240          FIND PATIENT WITH PATIENT-ID = #P-PATIENT-ID
1250            DELETE
1260            END TRANSACTION
1270          END-FIND
1280          ESCAPE ROUTINE
1290        END-IF
1300      END-IF
1310    NONE VALUE
1320      MOVE "INVALID PF KEY PRESSED" TO #G-MESSAGE
1330  END-DECIDE
1340*
1350END-REPEAT
1360*
1370* VALIDATION SUBROUTINE
1380*
1390DEFINE SUBROUTINE VALIDATION
1400*
1410MOVE TRUE TO #W-OK
1420MOVE "N" TO #W-CONFIRM-UPDATE
1430*
1440DECIDE FOR EVERY CONDITION
1450*
1460  WHEN PATIENT.FIRST-NAME = ' '
1470    MOVE (AD=I) TO #C-FIRST-NAME
1480    MOVE "FIRST NAME MUST BE ENTERED" TO #W-MESSAGE
1490    MOVE 1 TO #W-MARK
1500    PERFORM SET-MESSAGE
1510  WHEN PATIENT.SURNAME = ' '
1520    MOVE (AD=I) TO #C-SURNAME
1530    MOVE "LAST NAME MUST BE ENTERED" TO #W-MESSAGE
1540    MOVE 2 TO #W-MARK
1550    PERFORM SET-MESSAGE
1560  WHEN PATIENT.DOB > 980102 OR #V-DOB NOT = MASK(MMDDYY)
1570    MOVE (AD=I) TO #C-DOB
1580    MOVE "MUST ENTERED DATE OF BIRTH - FORMAT MM-DD-YY" TO #W-MESSAGE
1590    MOVE 3 TO #W-MARK
1600    PERFORM SET-MESSAGE
1610  WHEN NOT ( PATIENT.ADDRESS(*) NOT = ' ' )
1620    MOVE (AD=I) TO #C-ADDRESS
1630    MOVE "PLEASE ENTER AN ADDRESS" TO #W-MESSAGE
1640    MOVE 4 TO #W-MARK
1650    PERFORM SET-MESSAGE
1660*
1670* ATTEMPTED TO VALIDATE THE ARRIVAL DATE!
1680* FORMAT IS DD-NAMEOFMONTH-YY
1690*
1700  WHEN PATIENT.ARRIVED = " "
1710    MOVE (AD=I) TO #C-ARRIVED
1720    MOVE "PLEASE ENTER ARRIVED DATE - FORMAT E.G. 01-JANUARY-96"
1730      TO #W-MESSAGE
1740    MOVE 8 TO #W-MARK
1750    PERFORM SET-MESSAGE
1760  WHEN PATIENT.ARRIVED NOT = " "
1770    PERFORM VALIDATE-ARRIVED
1780  WHEN PATIENT.DUE-FOR-SURGERY NOT = MASK(YYMMDD)
1790    MOVE (AD=I) TO #C-DUE-FOR-SURGERY
1800    MOVE 9 TO #W-MARK
1810    MOVE "INVALID DUE FOR SURGERY FORMAT - MUST BE YY-MM-DD" TO #W-MESSAGE
1820    PERFORM SET-MESSAGE
1830  WHEN #L-TEMP-RELEASED-NUMERIC < #V-DUE-FOR-SURGERY-NUMERIC
1840    MOVE (AD=I) TO #C-RELEASED
1850    MOVE 10 TO #W-MARK
1860    MOVE "IMPOSSIBLE TO RELEASE BEFORE SURGERY!" TO #W-MESSAGE
1870    PERFORM SET-MESSAGE
1880*
1890* THE RELEASED FIELD IS DATE FORMAT AND EDIT MASK ON MAP IS CCYYMMDD, THEREFORE IT SHOULD
1900* VALIDATE ITSELF!
1910*
1920  WHEN #W-OK
1930    CALLNAT "XXCONUPD" #W-CONFIRM-UPDATE #G-SELECTED-OPTION
1940    IF #W-CONFIRM-UPDATE = 'Y'
1950      IF #G-SELECTED-OPTION = "A"
1960        STORE PATIENT
1970        END TRANSACTION
1980        FETCH "XX002P01"
1990      ELSE
2000        /* MUST BE MODIFY
2010        FIND PATIENT-UPDATE WITH PATIENT-ID = #P-PATIENT-ID
2020          MOVE BY NAME PATIENT TO PATIENT-UPDATE
2030          UPDATE
2040          END TRANSACTION
2050          ESCAPE ROUTINE
2060        END-FIND
2070      END-IF
2080    END-IF
2090  WHEN NONE
2100    MOVE "HOW DID WE GET HERE THEN MATEY!" TO #W-MESSAGE
2110    PERFORM SET-MESSAGE
2120END-DECIDE
2130*
2140END-SUBROUTINE
2150*
2160INCLUDE XXVALCC
2170*
2180DEFINE SUBROUTINE SET-MESSAGE
2190*
2200IF #G-MESSAGE = " "
2210  MOVE #W-MESSAGE TO #G-MESSAGE
2220  MOVE #W-MARK TO #W-MAP-MARK
2230  MOVE FALSE TO #W-OK
2240END-IF
2250*
2260END-SUBROUTINE
2270*
2280DEFINE SUBROUTINE GET-RECORD
2290*
2300INPUT #P-PATIENT-ID
2310FIND PATIENT WITH PATIENT-ID = #P-PATIENT-ID
2320END-FIND
2330*
2340END-SUBROUTINE
2350*
2360END
