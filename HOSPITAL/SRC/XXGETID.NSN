0010* VERY SIMPLE WAY OF GETTING THE NEXT AVAILABLE NUMBER FOR THE
0020* YEAR.
0030*
0040DEFINE DATA PARAMETER
005001 #P-ID(N7)
006001 REDEFINE #P-ID
0070  02 #P-ID-ALPHA(A7)
0080  02 REDEFINE #P-ID-ALPHA
0090    03 #P-YEAR(N2)
0100    03 #P-NUMBER(N5)
011001 #P-DATE(N6)
012001 REDEFINE #P-DATE
0130  02 #P-YY(N2)
0140  02 #P-MM(N2)
0150  02 #P-DD(N2)
0160*
0170LOCAL
018001 PATIENT VIEW PATIENT
0190  02 NEXT-ID-FOR-YEAR
0200  02 SURNAME
0210  02 PATIENT-ID
02201 #i (n7)
0230END-DEFINE
0240*
0250MOVE #P-YY TO #P-YEAR
0260MOVE 99999 TO #P-NUMBER
0270FIND PATIENT WITH PATIENT-ID = #P-ID
0280  IF NO RECORDS FOUND
0290    MOVE #P-ID TO PATIENT.PATIENT-ID
0300    MOVE 1 TO NEXT-ID-FOR-YEAR
0310    COMPRESS "CONTROL RECORD" #P-YY INTO PATIENT.SURNAME
0320    STORE PATIENT
0330    END TRANSACTION
0340    MOVE 1 TO #P-NUMBER
0350    ESCAPE ROUTINE
0360  END-NOREC
0370  ADD 1 TO PATIENT.NEXT-ID-FOR-YEAR
0380  UPDATE (0270)
0390  END TRANSACTION
0400  MOVE PATIENT.NEXT-ID-FOR-YEAR TO #P-NUMBER
0410END-FIND
0420*
0430END
