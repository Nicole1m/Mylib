0010* LISTING PATIENTS ORDER MENU
0020DEFINE DATA GLOBAL USING XX000G00
0030LOCAL
004001 #M-OPTION(A1)
005001 #M-YEAR(N2)
006001 #W-MARK(P3)
0070END-DEFINE
0080*
0090SET KEY ALL
0100*
0110REPEAT
0120*
0130INPUT MARK #W-MARK USING MAP "XX024M01"
0140RESET #G-MESSAGE
0150*
0160DECIDE ON FIRST VALUE OF *PF-KEY
0170*
0180VALUE "PF12", "PF24"
0190   PERFORM XXEXIT
0200VALUE "PF3", "PF15"
0210   FETCH "XX002P01"
0220VALUE "ENTR"
0230   MOVE #M-OPTION TO #G-SELECTED-OPTION
0240   DECIDE ON FIRST VALUE OF #M-OPTION
0250   VALUE "P"
0260       IF #M-YEAR = 0
0270          MOVE "YEAR MUST BE ENTERED FOR THE P OPTION" TO #G-MESSAGE
0280          MOVE 2 TO #W-MARK
0290          ESCAPE TOP
0300       END-IF
0310       STACK TOP DATA FORMATTED #M-YEAR
0320       FETCH RETURN "XX023P01"
0330   VALUE "N"
0340       FETCH RETURN "XX025P01"
0350   NONE VALUE
0360       MOVE "INVALID OPTION SELECTED" TO #G-MESSAGE
0370       MOVE 1 TO #W-MARK
0380       ESCAPE TOP
0390   END-DECIDE
0400NONE VALUE
0410   MOVE "INVALID PF KEY PRESSED" TO #G-MESSAGE
0420   ESCAPE TOP
0430END-DECIDE
0440*
0450END-REPEAT
0460*
0470END
