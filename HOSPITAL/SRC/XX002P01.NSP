0010DEFINE DATA
0020GLOBAL
0030  USING XX000G00
0040LOCAL
0050  USING XX002L01
0060*
0070local
00801 #e (a10)
0090
0100END-DEFINE
0110*
0120SET KEY ALL
0130*
0140REPEAT
0150*
0160  INPUT USING MAP "XX002M01"
0170  RESET #M-MESSAGE
0180*
0190  DECIDE ON FIRST VALUE OF *PF-KEY
0200*
0210    VALUE "PF3", "PF15"
0220      FETCH "XX001P01"
0230    VALUE "PF12", "PF24"
0240      PERFORM XXEXIT
0250    VALUE "ENTR"
0260      DECIDE ON FIRST VALUE OF #M-OPTION
0270        VALUE "A"
0280          MOVE "A" TO #G-SELECTED-OPTION
0290          FETCH "XX021P01"  /* ADD NEW PATIENT
0300        VALUE "M", "D"
0310          FETCH "XX024P01"  /* MODIFY/DELETE PATIENT - TAKE THEM TO A LIST!
0320        NONE VALUE
0330          MOVE "INVALID OPTION SELECTED" TO #M-MESSAGE
0340          ESCAPE TOP
0350      END-DECIDE
0360    NONE VALUE
0370      MOVE "INVALID PF KEY PRESSED" TO #M-MESSAGE
0380  END-DECIDE
0390*
0400END-REPEAT
0410*
0420END
