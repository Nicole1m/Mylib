0005DEFINE DATA LOCAL 
00061 #XML (A) DYNAMIC 
00071 #NAME (A) DYNAMIC
00081 #VALUE (A) DYNAMIC 
0009
00101 #VAR (A30)
00111 #VAL (A30)
0012
00131 #FIELD-NAME (A30)
00141 #FIELD-VALUE (A30)
0015
0016END-DEFINE
0017
0018DEFINE WORK FILE 1 'c:\Training\dam-xml.xml'
0019DEFINE WORK FILE 2 'c:\Training\Dam text file.txt'
0020
0021
0022READ WORK 1 ONCE #XML
0023
0024PARSE XML #XML INTO NAME #NAME VALUE #VALUE 
0025
0026  COMPRESS #NAME INTO #VAR 
0027  COMPRESS #VALUE INTO #VAL
0028
0029  IF #VAR GT ' '
0030    MOVE #VAR TO #FIELD-NAME
0031  END-IF
0032
0033  IF #VAL GT ' '
0034    MOVE #VAL TO #FIELD-VALUE
0035    WRITE WORK FILE 2 VARIABLE #FIELD-NAME #FIELD-VALUE
0036  END-IF
0037
0038END-PARSE
0039
0040
0041END
