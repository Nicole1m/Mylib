0005DEFINE DATA LOCAL
00061 #COUNTRIES (A100)
00071 #NUMBER (A5)
00081 #COUNTRY-NAME  (A30)
00091 #POPULATION (A15)
00101 #REGION (A20)
0011END-DEFINE
0012* 
0013FORMAT PS= 22
0014* FORMAT LS =200
0015*
0016DEFINE WORK FILE 1 'C:\Training\afr-countries.txt'
0017
0018RD1. READ WORK 1 #COUNTRIES
0019*
0020  PERFORM  #COUNTRIES
0021*
0022
0023  DISPLAY
0024    #NUMBER
0025    #COUNTRY-NAME
0026    #POPULATION
0027    #REGION
0028
0029  AT END OF DATA
0030    WRITE 'Total countries in SA:'
0031      COUNT (#COUNTRIES)
0032  END-ENDDATA
0033
0034END-WORK
0035
0036DEFINE SUBROUTINE #COUNTRIES
0037
0038SEPARATE #COUNTRIES
0039  INTO #NUMBER
0040  #COUNTRY-NAME
0041  #POPULATION
0042  #REGION
0043  WITH DELIMITER '#'
0044
0045EXAMINE #POPULATION
0046  FOR ','
0047DELETE
0048MOVE RIGHT #POPULATION TO #POPULATION
0049
0050END-SUBROUTINE
0051
0052END
