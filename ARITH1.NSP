0005DEFINE DATA LOCAL
00061 ADD-FIELD1 (N5) INIT<1>
00071 ADD-FIELD2 (N5) INIT<2>
00081 ADD-FIELD3 (N10)
0009*
00101 SUB-FIELD1 (N5) INIT<10>
00111 SUB-FIELD2 (N5) INIT<15>
00121 SUB-FIELD3 (N10)
0013*
00141 MULT-FIELD1 (N5) INIT<3>
00151 MULT-FIELD2 (N5) INIT<3>
00161 MULT-FIELD3 (N10)
0017*
00181 DIV-FIELD1 (N5) INIT<5>
00191 DIV-FIELD2 (N5) INIT<25>
00201 DIV-FIELD3 (N10)
0021END-DEFINE
0022
0023COMPUTE ADD-FIELD3 := ADD-FIELD1 + ADD-FIELD2
0024WRITE / 'ADD' 
0025/ ADD-FIELD1'+'ADD-FIELD2 '==' ADD-FIELD3
0026
0027COMPUTE SUB-FIELD3:= SUB-FIELD2 - SUB-FIELD1
0028WRITE / 'SUBTRACT'
0029/ SUB-FIELD2 '-' SUB-FIELD1 '==' SUB-FIELD3
0030 
0031 COMPUTE MULT-FIELD3 := MULT-FIELD1 * MULT-FIELD2
0032 WRITE / 'MULTIPLY' 
0033 /MULT-FIELD1 '*' MULT-FIELD2 '==' MULT-FIELD3
0034 
0035 COMPUTE DIV-FIELD3 := DIV-FIELD2 / DIV-FIELD1
0036 WRITE / 'DIVIDE'
0037 /DIV-FIELD2 '/' DIV-FIELD1 '==' DIV-FIELD3
0038END
