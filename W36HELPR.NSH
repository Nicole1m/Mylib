0004/* TODO Enter your code here
0005DEFINE DATA 
0006PARAMETER
00071 MAR-STAT (A1)
0008
0009LOCAL
00101 #SELECT (A1/1:4)
00111 #INDEX (N1)
0012
0013END-DEFINE
0014
0015
0016
0017INPUT USING MAP "W36HMAP"
0018
0019IF *PF-KEY = 'PF3'
0020  ESCAPE MODULE
0021END-IF
0022
0023DECIDE FOR FIRST CONDITION
0024  WHEN #SELECT(1) NE ' '
0025    MOVE 'W' TO MAR-STAT
0026  WHEN #SELECT(2) NE ' '
0027    MOVE 'S' TO MAR-STAT
0028  WHEN #SELECT(3) NE ' '
0029    MOVE 'D' TO MAR-STAT
0030  WHEN #SELECT(4) NE ' '
0031    MOVE 'M' TO MAR-STAT
0032
0033  WHEN  NONE
0034    REINPUT ' Please select one option with "X"'
0035
0036END-DECIDE
0037END
