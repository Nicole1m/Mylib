0005DEFINE DATA LOCAL 
000601 ARRAY-1 (A1/ 1:14) INIT < 'A','C','K','N','O','W','L','E','D','G','M','E','N','T'>
000701 ARRAY-2 (A2/ 1:14)
000801 INDEX (I2)
0009END-DEFINE
0010
0011WRITE 'INITIAL ARRAY-1=' ARRAY-1(*)
0012
0013
0014FOR INDEX = 1 TO 14
0015  ARRAY-2(INDEX) := ARRAY-1(15-INDEX)
0016
0017END-FOR
0018WRITE 'REVERSED ARRAY=' ARRAY-2(*)
0019END
