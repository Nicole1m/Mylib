0005DEFINE DATA LOCAL
00061 YACHT-NAME1 (A10) CONST<'Carmen'>
00071 YACHT-NAME2 (A10) CONST<'Blue eyes'>
00081 YACHT-NAME3 (A10) CONST<'Aurora'>
00091 YACHT-NAME4 (A10) CONST<'Pandora'>
00101 YACHT-NAME5 (A10) CONST<'Yvutte'>
0011END-DEFINE
0012*
0013IF YACHT-NAME2=YACHT-NAME3 THRU YACHT-NAME5
0014    BUT NOT YACHT-NAME1 THRU YACHT-NAME5
0015
0016  WRITE 'Yacht' YACHT-NAME2 'is between'
0017    YACHT-NAME3 'and' YACHT-NAME5
0018    'but not between' YACHT-NAME1 'and' YACHT-NAME5
0019END-IF
0020*
0021IF YACHT-NAME1 GE YACHT-NAME3
0022  WRITE 'Yacht:' YACHT-NAME1
0023    'is greater equal than' YACHT-NAME3
0024END-IF
0025END
